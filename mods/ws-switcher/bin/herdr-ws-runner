#!/bin/sh
# The workspaces' background runner: automations and board cards' pull requests,
# kept going while Herdr's window is closed. Off, Herdr runs them itself, while
# it's open. On, they run in a Node process that herdr-core holds as a terminal
# named herdr-ws-runner, so closing or updating Herdr doesn't stop them; or, with
# Start at login, that launchd (macOS), systemd (Linux) or Task Scheduler (Windows) starts when you log in,
# outside herdr-core.
#
#   herdr-ws-runner --on            turn it on and start it
#   herdr-ws-runner --off           turn it off and stop it (Herdr runs them again); Start at login goes off too
#   herdr-ws-runner --status        on or off, and whether it's running (--json: for a screen)
#   herdr-ws-runner --start         start it if it's on and not running (Herdr does this when it opens)
#   herdr-ws-runner --login on      start it at login too: it turns it on, and launchd (macOS), a
#                                   systemd user unit (Linux) or a scheduled task (Windows) runs it
#   herdr-ws-runner --login off     not at login any more (herdr-core runs it again while it's on)
#   herdr-ws-runner --login status  whether it starts at login
#   herdr-ws-runner --serve         what the terminal (or launchd, systemd, Task Scheduler) runs
#
# It needs Node 20.6 or newer. Without Start at login, after a restart of the
# computer it starts when Herdr first opens (or with --start), and schedules
# missed in between are caught up as after any time away. Under launchd or systemd
# it doesn't start herdr-core: scripts and checks run with nothing else open, and
# an agent run starts herdr-core when it needs it.
# Its log: hc read herdr-ws-runner --lines 100 (started at login: ~/.herdr/runner/runner.log)
set -eu

name=herdr-ws-runner
label=dev.herdr.ws-runner
dir=$HOME/.herdr/runner
agents=${HERDR_WS_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}
plist=$agents/$label.plist
# Linux: the systemd user unit that starts it at login.
units=${HERDR_WS_SYSTEMD_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}
unit=$units/$name.service
self=$0
while [ -L "$self" ]; do
  t=$(readlink "$self")
  case $t in /*) self=$t ;; *) self=$(dirname "$self")/$t ;; esac
done
self=$(cd "$(dirname "$self")" && pwd)/$(basename "$self")
mod=$(dirname "$(dirname "$self")")

is_on() { [ "$(cat "$dir/switch" 2>/dev/null || true)" = on ]; }
mac() { [ "$(uname)" = Darwin ]; }
linux() { [ "$(uname)" = Linux ]; }
# Git for Windows' sh (MSYS2): uname says MINGW64_NT-…, MSYS_NT-… or CYGWIN_NT-….
windows() { case $(uname) in MINGW*|MSYS*|CYGWIN*) return 0 ;; esac; return 1; }
# A process by its pid: on Windows node's pid is Windows', which Git's kill can't see.
alive() {
  if windows; then tasklist //FI "PID eq $1" //NH 2>/dev/null | grep -q " $1 "; else kill -0 "$1" 2>/dev/null; fi
}
# Windows: the scheduled task that starts it at login (Task Scheduler Library > Herdr).
task='\Herdr\herdr-ws-runner'
# What starts it at login: the LaunchAgent's file on macOS, the systemd unit's on Linux, the
# scheduled task on Windows (Task Scheduler keeps no file of ours).
job() { if mac; then echo "$plist"; elif windows; then echo "Task Scheduler: $task"; else echo "$unit"; fi; }
login_on() { if windows; then schtasks //query //tn "$task" >/dev/null 2>&1; else [ -f "$(job)" ]; fi; }
# Start at login needs launchd, a running systemd user manager, or PowerShell (for Task Scheduler).
can_login() {
  mac || { linux && command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; } ||
    { windows && command -v powershell >/dev/null 2>&1; }
}

# Its pid (and how it runs: via), if it said it was alive within the last 30 seconds and still is.
running() {
  [ -f "$dir/alive" ] || return 1
  pid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$dir/alive")
  at=$(sed -n 's/.*"at":\([0-9]*\).*/\1/p' "$dir/alive")
  via=$(sed -n 's/.*"via":"\([a-z]*\)".*/\1/p' "$dir/alive")
  [ -n "$pid" ] && [ -n "$at" ] || return 1
  [ $(( $(date +%s) - at / 1000 )) -lt 30 ] || return 1
  alive "$pid"
}

need_node() {
  command -v node >/dev/null 2>&1 || { echo "$name: Node isn't on your PATH. It needs Node 20.6 or newer." >&2; exit 127; }
  node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>20||(a===20&&b>=6)?0:1)' ||
    { echo "$name: Node $(node -v) is too old. It needs 20.6 or newer." >&2; exit 1; }
}

# The one herdr-core holds, if there is one.
stop_hc() {
  command -v hc >/dev/null 2>&1 || return 0
  hc kill "$name" >/dev/null 2>&1 || true
  hc rm "$name" >/dev/null 2>&1 || true
}

# The launchd job (or systemd unit, or scheduled task), loaded again from its file (run now), or unloaded.
domain() { echo "gui/$(id -u)"; }
load_job() {
  if windows; then
    schtasks //run //tn "$task" >/dev/null
  elif mac; then
    launchctl bootout "$(domain)/$label" >/dev/null 2>&1 || true
    launchctl bootstrap "$(domain)" "$plist"
  else
    systemctl --user daemon-reload
    systemctl --user enable "$name.service" >/dev/null 2>&1
    systemctl --user restart "$name.service"
  fi
}
unload_job() {
  if windows; then
    # Ending the task ends only its console: the runner's node goes by its pid.
    if running && [ "${via:-}" = task ]; then taskkill //PID "$pid" //T //F >/dev/null 2>&1 || true; fi
    schtasks //end //tn "$task" >/dev/null 2>&1 || true
  elif mac; then launchctl bootout "$(domain)/$label" >/dev/null 2>&1 || true
  elif command -v systemctl >/dev/null 2>&1; then
    systemctl --user disable --now "$name.service" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$name.service" >/dev/null 2>&1 || true
  fi
}

# The file (or scheduled task) that starts it at login, gone.
remove_job() {
  if windows; then schtasks //delete //tn "$task" //f >/dev/null 2>&1 || true
  else rm -f "$(job)"; fi
}

start() {
  running && return 0
  need_node
  # Started at login: launchd or systemd runs it (again, if it stopped).
  if mac && login_on; then
    launchctl kickstart "$(domain)/$label" >/dev/null 2>&1 || load_job
    return 0
  fi
  if linux && login_on && can_login; then
    systemctl --user start "$name.service" >/dev/null 2>&1 || load_job
    return 0
  fi
  if windows && login_on; then
    # Task Scheduler ignores a run while an instance is there (one whose node stopped answering):
    # that one ends first.
    unload_job
    load_job
    return 0
  fi
  command -v hc >/dev/null 2>&1 || { echo "$name: hc (herdr-core) isn't on your PATH." >&2; exit 127; }
  # One left over that isn't answering.
  stop_hc
  # Windows: herdr-core starts Windows programs, not this script; Git's sh runs it (a login
  # shell: Git's PATH, then Windows' with node, gh and git).
  if windows; then
    hc run --bg --no-parent --name "$name" --cwd "$HOME" -- "$(cygpath -m /)/bin/sh.exe" -lc 'exec "$0" --serve' "$self" >/dev/null
    return
  fi
  sh=${SHELL:-/bin/sh}
  # Through your shell, as agents start: its PATH has node, gh and git.
  case $(uname) in Darwin) flag=-lic ;; *) flag=-ic ;; esac
  case $(basename "$sh") in
    fish) hc run --bg --no-parent --name "$name" --cwd "$HOME" -- "$sh" "$flag" 'exec $argv[1] --serve' "$self" >/dev/null ;;
    sh|bash|zsh|dash|ksh) hc run --bg --no-parent --name "$name" --cwd "$HOME" -- "$sh" "$flag" 'exec "$0" --serve' "$self" >/dev/null ;;
    *) hc run --bg --no-parent --name "$name" --cwd "$HOME" -- "$self" --serve >/dev/null ;;
  esac
}

# Text for a plist: & < > " ' as XML has them.
xml() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' -e "s/'/\&apos;/g"; }
# A word for sh in single quotes.
squote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# The LaunchAgent: your login shell runs this script's --serve, at login, and again if it stops with
# an error (not when it's turned off). Not an interactive one (-lc): launchd gives it no terminal, and
# a .zshrc that wants one (a prompt theme, attaching to tmux) would get in the way. So the PATH it
# runs with is the one --login on had (node was found on it), as the terminal's has node, gh and git.
write_plist() {
  sh=${SHELL:-/bin/sh}
  case $(basename "$sh") in sh|bash|zsh|dash|ksh|fish) ;; *) sh=/bin/sh ;; esac
  cmd="HERDR_WS_RUNNER_VIA=launchd exec $(squote "$self") --serve"
  [ "$(basename "$sh")" != fish ] || cmd="set -x HERDR_WS_RUNNER_VIA launchd; exec $(squote "$self") --serve"
  mkdir -p "$agents" "$dir"
  tmp=$plist.$$.tmp
  cat > "$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml "$sh")</string>
    <string>-lc</string>
    <string>$(xml "$cmd")</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$(xml "$PATH")</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$(xml "$HOME")</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>$(xml "$dir/runner.log")</string>
  <key>StandardErrorPath</key>
  <string>$(xml "$dir/runner.log")</string>
</dict>
</plist>
EOF
  mv "$tmp" "$plist"
}

# Text inside a systemd unit's double quotes: \ " as escapes, % and $ doubled (specifiers, variables).
sdq() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/%/%%/g' -e 's/\$/$$/g'; }

# The systemd user unit, as the LaunchAgent: your login shell runs this script's --serve (-lc, no
# terminal), with the PATH --login on had (node was found on it), and again after an error, not
# when it's turned off or another runner is running (both end it with 0). With linger on (hc turns
# it on), systemd starts it at boot rather than at the first login.
write_unit() {
  sh=${SHELL:-/bin/sh}
  case $(basename "$sh") in sh|bash|zsh|dash|ksh|fish) ;; *) sh=/bin/sh ;; esac
  case $sh in /*) ;; *) sh=/bin/sh ;; esac
  cmd="exec $(squote "$self") --serve"
  mkdir -p "$units" "$dir"
  tmp=$unit.$$.tmp
  cat > "$tmp" <<EOF
# Herdr workspaces' background runner at login: herdr-ws-runner --login on wrote this, --login off removes it.
[Unit]
Description=Herdr workspaces' background runner

[Service]
Environment=HERDR_WS_RUNNER_VIA=systemd
Environment="PATH=$(sdq "$PATH")"
WorkingDirectory=%h
ExecStart="$(sdq "$sh")" -lc "$(sdq "$cmd")"
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.herdr/runner/runner.log
StandardError=append:%h/.herdr/runner/runner.log

[Install]
WantedBy=default.target
EOF
  mv "$tmp" "$unit"
}

# The scheduled task: at your sign-in, Git's sh (a login shell: node, gh and git on its PATH) runs
# this script's --serve in a console nobody sees (conhost --headless), its output in runner.log.
# No time limit (Task Scheduler's default stops a task after 3 days), on battery too; a crash is
# --serve's to start again. Only while you're signed in: no password is stored. The paths go in
# through the environment and the script encoded, so no quoting reaches PowerShell.
write_task() {
  mkdir -p "$dir"
  ps=$(cat <<'PS'
$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'
trap { [Console]::Error.WriteLine("can't add the scheduled task: " + $_.Exception.Message.Trim()); exit 1 }
$cmd = 'HERDR_WS_RUNNER_VIA=task exec "$0" --serve >>"$1" 2>&1'
$arg = '--headless "{0}" -lc ''{1}'' "{2}" "{3}"' -f $env:HERDR_TASK_SH, $cmd, $env:HERDR_TASK_SELF, $env:HERDR_TASK_LOG
$me = [Security.Principal.WindowsIdentity]::GetCurrent().Name
$a = New-ScheduledTaskAction -Execute "$env:SystemRoot\System32\conhost.exe" -Argument $arg -WorkingDirectory $env:USERPROFILE
$t = New-ScheduledTaskTrigger -AtLogOn -User $me
$s = New-ScheduledTaskSettingsSet -ExecutionTimeLimit ([TimeSpan]::Zero) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -MultipleInstances IgnoreNew
$p = New-ScheduledTaskPrincipal -UserId $me -LogonType Interactive -RunLevel Limited
Register-ScheduledTask -TaskPath '\Herdr\' -TaskName 'herdr-ws-runner' -Action $a -Trigger $t -Settings $s -Principal $p -Description 'Herdr workspaces background runner: herdr-ws-runner --login on made this, --login off removes it.' -Force | Out-Null
PS
)
  enc=$(printf '%s' "$ps" | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\n')
  HERDR_TASK_SH=$(cygpath -w "$(cygpath -m /)/bin/sh.exe") HERDR_TASK_SELF=$(cygpath -m "$self") HERDR_TASK_LOG=$(cygpath -m "$dir/runner.log") \
    powershell -NoProfile -NonInteractive -EncodedCommand "$enc" >/dev/null
}

no_login() {
  if linux; then echo "$name: Start at login needs a systemd user session (systemctl --user); none answered here." >&2
  elif windows; then echo "$name: Start at login needs PowerShell (Task Scheduler's commands); none answered here." >&2
  else echo "$name: Start at login is for macOS (launchd), Linux (systemd) and Windows (Task Scheduler)." >&2
  fi
  exit 1
}

case ${1:-} in
  --on)
    need_node
    mkdir -p "$dir"
    echo on > "$dir/switch"
    start
    echo "on: automations and pull requests are followed while Herdr is closed too"
    ;;
  --off)
    mkdir -p "$dir"
    echo off > "$dir/switch"
    stop_hc
    # Turned off, it doesn't start at login either.
    if login_on; then unload_job; remove_job; fi
    rm -f "$dir/alive"
    echo "off: Herdr runs them itself, while it's open"
    ;;
  --status)
    login=false
    login_on && login=true
    if [ "${2:-}" = --json ]; then
      on=false; run=false; p=null; v=null
      is_on && on=true
      if running; then run=true; p=$pid; v="\"${via:-hc}\""; fi
      printf '{"on":%s,"running":%s,"pid":%s,"via":%s,"login":%s,"plist":"%s"}\n' "$on" "$run" "$p" "$v" "$login" "$(job | sed 's/\\/\\\\/g; s/"/\\"/g')"
    elif ! is_on; then echo off
    elif running; then
      case ${via:-hc} in launchd|systemd) echo "on, running via $via (pid $pid)" ;; task) echo "on, running via Task Scheduler (pid $pid)" ;; *) echo "on, running in herdr-core (pid $pid)" ;; esac
      [ "$login" = false ] || echo "starts at login ($(job))"
    else echo "on, not running (herdr-ws-runner --start starts it; Herdr does when it opens)"
    fi
    ;;
  --start)
    is_on || { echo "$name: it's off (--on turns it on)" >&2; exit 1; }
    start
    ;;
  --login)
    case ${2:-} in
      on)
        can_login || no_login
        need_node
        # Windows: the task first, so a refusal leaves the runner as it was.
        if windows; then write_task || exit 1; fi
        mkdir -p "$dir"
        echo on > "$dir/switch"
        # One runner at a time: the one herdr-core holds (or launchd's or systemd's from before) goes,
        # and is gone before the new one starts: one still ending would look alive to it, and it would leave.
        old=
        if running; then old=$pid; fi
        stop_hc
        unload_job
        if [ -n "$old" ]; then
          n=0
          while alive "$old" && [ "$n" -lt 30 ]; do sleep 0.1; n=$((n + 1)); done
        fi
        rm -f "$dir/alive"
        if mac; then write_plist; elif ! windows; then write_unit; fi
        load_job
        if mac; then echo "on at login: launchd starts it when you log in, without herdr-core ($plist)"
        elif windows; then echo "on at login: Task Scheduler starts it when you sign in, without herdr-core ($task)"
        else echo "on at login: systemd starts it when you log in, without herdr-core ($unit)"
        fi
        ;;
      off)
        was=
        login_on && was=1
        unload_job
        remove_job
        rm -f "$dir/alive"
        # Still on: herdr-core runs it again, as before Start at login.
        if is_on; then start; echo "off at login: it runs in herdr-core while it's on (Herdr starts it when it opens)"
        else echo "off at login${was:+ (it was on)}"
        fi
        ;;
      status|"")
        if login_on; then echo "on at login ($(job))"; else echo "off at login"; fi
        ;;
      *) echo "$name: --login on, off or status" >&2; exit 2 ;;
    esac
    ;;
  --serve)
    need_node
    # A crash starts it again; turned off, or another one running, it ends.
    while is_on; do
      # Its log under launchd or systemd (runner.log) keeps the last 1000 lines when it's over 1 MB;
      # the whole of it before is runner.log.old. In place: launchd or systemd holds the file open.
      log=$dir/runner.log
      if [ -f "$log" ] && [ "$(wc -c < "$log")" -gt 1048576 ]; then
        cp "$log" "$log.old" && tail -n 1000 "$log.old" > "$log"
      fi
      # Windows' node takes --import as a URL only (C:/… is read as the scheme "c:").
      reg=$mod/runner/register.js
      ! windows || reg=file:///$(cygpath -m "$reg")
      node --import "$reg" "$mod/runner/main.js" && break
      echo "$name: it stopped; starting again in 5 seconds" >&2
      sleep 5
    done
    ;;
  *)
    sed -n '2,22p' "$self" | sed 's/^# \{0,1\}//'
    [ "${1:-}" = --help ] || [ "${1:-}" = -h ] || exit 2
    ;;
esac
