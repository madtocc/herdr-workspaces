#!/bin/sh
# Workspace automations from outside Herdr: start one now (a script, a git hook,
# Raycast, Shortcuts), add one (once at a time, or repeating; an agent's task or,
# with --shell, a script that runs without an agent), turn one off, or list them.
# Agents started in a workspace through herdr-ws-agent are told about --add, so
# "tomorrow at 6, check X" becomes an automation.
#
#   herdr-ws-run <workspace> <automation> [text...]   start it now; the text fills {{text}}
#   herdr-ws-run <workspace> <automation> -           the text from stdin
#   herdr-ws-run --add (--at TIME | --when LINE) [...] prompt   add one (--help says more)
#   herdr-ws-run --off <automation>                   turn one off
#   herdr-ws-run --on <automation> [--at TIME]        turn one back on (a new time for a one-time one)
#   herdr-ws-run --list                               every automation and its when: line
#
# --global with --add makes one for every workspace (~/.herdr/automations); with
# --off or --on it turns that one off or on everywhere. Without it, --off and --on
# on a global one turn it off or on in this workspace only (its `off:` line).
#
# A start runs like the Automations screen's Run now, even when the automation is
# off. Herdr's ws-switcher picks it up within two seconds; one made while Herdr is
# closed runs when it opens, if that's within an hour. <workspace> is the folder
# name in ~/.herdr/workspaces; --add and --off find it from the current folder,
# the way herdr-ws-agent does, unless given --workspace. Times are this computer's.
#
# While Automations is off in Herdr's Settings > Features (~/.herdr/settings.jsonc,
# "features": { "automations": false }), nothing runs: a start is refused (exit 3),
# and --add, --on and --list say that what they show or keep waits until it's on.
# Without Node it can't read that file as Herdr does, so it only says they may be off
# and goes on (Herdr then refuses the start and notes it as skipped).
set -eu

dir=$HOME/.herdr/workspaces
global=$HOME/.herdr/automations
index=$dir/.index
# herdr-core's own folder (config, templates): %APPDATA%\herdr-core on Windows, as herdr-core has it.
case $(uname -s) in
  MINGW* | MSYS* | CYGWIN*) hcdir=${XDG_CONFIG_HOME:-$(cygpath -m "${APPDATA:-$HOME/AppData/Roaming}")}/herdr-core ;;
  *) hcdir=${XDG_CONFIG_HOME:-$HOME/.config}/herdr-core ;;
esac
templates=$hcdir/templates
tab=$(printf '\t')
usage="usage: herdr-ws-run <workspace> <automation> [text... | -]
       herdr-ws-run --add (--at TIME | --when LINE) [--name NAME] [--agent NAME] [--model M] [--effort E] [--folder DIR] [--check CMD] [--card] [--keep] [--workspace ID | --global] prompt... | -
       herdr-ws-run --add (--at TIME | --when LINE) --shell [bash|zsh|sh] [--terminal] [--name NAME] [--folder DIR] [--check CMD] [--keep] [--workspace ID | --global] script... | -
         (either: [--timeout DUR] [--notify problems|results|all|none] [--missed run|skip|always] [--dedupe changed|always] [--secret-env VAR=name]...)
       herdr-ws-run --off <automation> [--workspace ID | --global]
       herdr-ws-run --on <automation> [--at TIME] [--workspace ID | --global]
       herdr-ws-run --list
       herdr-ws-run --help"

die() { echo "herdr-ws-run: $*" >&2; exit 1; }

# This script's folder, through the link in ~/.local/bin: the mod's settingsfacts.js is beside it.
self=$0
while [ -L "$self" ]; do
  t=$(readlink "$self")
  case $t in /*) self=$t ;; *) self=$(dirname "$self")/$t ;; esac
done
mod=$(cd "$(dirname "$self")/.." 2>/dev/null && pwd)
settings=$HOME/.herdr/settings.jsonc

# Automations is off in Settings > Features, read as Herdr reads it (settingsfacts.js, with
# Node): a file that isn't JSONC counts as all on. Without Node it never says off, since a
# broken file or a /* comment */ could fool a plain look: when that look finds
# "automations": false, it sets maybe_off, and the callers say they may be off.
automations_off() {
  maybe_off=
  [ -f "$settings" ] || return 1
  if command -v node >/dev/null 2>&1 && [ -f "$mod/settingsfacts.js" ]; then
    node --input-type=module -e '
      const { parseSettings, featureOn } = await import(process.argv[1]);
      const { readFileSync } = await import("node:fs");
      process.exit(featureOn(parseSettings(readFileSync(process.argv[2], "utf8")), "automations") ? 1 : 0);
    ' "file://$mod/settingsfacts.js" "$settings" 2>/dev/null
    return
  fi
  if sed -e 's,^[[:space:]]*//.*,,' -e 's,[[:space:]]//.*,,' "$settings" | tr -d ' \t\r\n' | grep -q '"features":{[^}]*"automations":false'; then
    maybe_off=1
  fi
  return 1
}
off_words="Automations are off in Herdr's Settings > Features"
maybe_words="Automations may be off in Herdr's Settings > Features (without Node, herdr-ws-run can't read ~/.herdr/settings.jsonc as Herdr does)"
# What that means for what was just asked ($1), when they're off or may be.
off_note() {
  if automations_off; then echo "$off_words: $1" >&2
  elif [ -n "$maybe_off" ]; then echo "$maybe_words. If they are, $1" >&2
  fi
}

help() {
  cat <<'EOF'
herdr-ws-run: Herdr workspace automations. An automation starts an agent with a
prompt, in a new tab of the workspace's "Automations" space, while Herdr is open.
With --shell it runs a script instead, with no agent and no tab.

Have an agent do something later, from a folder in the workspace:

  herdr-ws-run --add --at "tomorrow 6am" "Check whether X. If it is, do Y."
  herdr-ws-run --add --when "weekdays 09:00" --name morning-review --agent reviewer \
    "Review the changes merged since yesterday and list what needs a follow-up."
  herdr-ws-run --add --when "every 30m" --name review-requests --model haiku \
    --check "gh pr list --search 'review-requested:@me' --json number,title -q '.[] | [.number, .title] | @tsv'" \
    "Pull requests waiting for my review: {{check}} Summarize each in two lines."

  --at TIME       once, then it turns itself off: "tomorrow 6am", "today 18:30",
                  "in 2 hours", "monday 9am" (the next one), "2026-11-12 06:00",
                  or just "6am" (the next 6:00)
  --when LINE     repeating, as an automation's when: line: "every 2h",
                  "weekdays 09:00", "mon,wed 8:30", "0 9 * * 1-5" (cron),
                  "task enters review", "agent done", "files inbox",
                  "github api pr opened", "github * issue opened" (any repo
                  of the workspace), "github api pr review-requested",
                  "github api pr merged", "github api ci failed",
                  "github api issue labeled:bug" (a label added later too),
                  "startup" (when Herdr or its runner starts), "wake" (the
                  Mac wakes), "automation done NAME" / "automation failed
                  NAME" (after another one here; it gets what that one said
                  as {{output}} and $HERDR_OUTPUT)
  --name NAME     letters, digits, - and _ (needed with --when)
  --agent NAME    a preset (herdr-ws-agent --presets lists them) or a program;
                  default: the workspace board's agent, else claude
  --model MODEL   its model, in place of the preset's: for claude fable, opus,
                  sonnet or haiku; codex, pi, agy, opencode, grok and gemini
                  take their own names (pi and opencode as provider/model).
                  Pick the smallest that does the job: haiku for checks and
                  summaries
  --effort LEVEL  its effort: claude low, medium, high, xhigh, max; codex
                  minimal to max; pi off to max; agy low to max; opencode,
                  grok and gemini take none
  --folder DIR    where it runs; default: the current folder
  --check CMD     shell that Herdr runs first, in the folder, each
                  time: the agent starts only if it prints something, and gets
                  what it printed as {{check}} (added at the end of the prompt
                  unless the prompt uses {{check}}). Prints nothing: no agent
                  starts, at no cost. With a repeating time (--when "every 2h",
                  "weekdays 09:00"), printing the same as at the last check is
                  nothing new either, so it can just list what's open now.
                  Give one whenever a plain command can tell if there's
                  anything to do ("check X, and if so do Y": X is the check).
                  It should only read, never change things.
                  What set it off is in $HERDR_NUMBER, $HERDR_TITLE,
                  $HERDR_TASK_ID, $HERDR_FILES and so on; {{…}} isn't filled
                  in inside it. Try it in the folder first: sh -c 'CMD'
                  It may be several lines. To start on what it prints
                  even when that's the same as last time, add --dedupe always.
                  The person has to allow a check you add before it runs:
                  Herdr asks them with a toast as soon as it's added, and
                  the automation doesn't start until they do. Tell them.
  --card          also put a card for each run on the workspace's board
  --keep          leave each run's tab open when its agent finishes (the newest
                  three stay). Without it the tab closes a few seconds after
                  the agent is done, and History lists the run. Give it when
                  the agent asks the person questions or the run is a
                  conversation: ending a turn with a question looks finished
  --shell [SH]    no agent: the prompt is a script, run with bash (or zsh,
                  sh) in the folder, unseen; what it prints goes to History.
                  Use it when a plain command does the whole job. The run's
                  fill-ins are $HERDR_EVENT, $HERDR_CHECK, $HERDR_OUTPUT and
                  so on ({{…}} isn't filled in inside it). The person has to
                  allow the script before it runs, as a check. Tell them.
  --terminal      (with --shell) run it in a tab of the Automations space
  --timeout DUR   stop a run that goes on longer: 30s, 2m, 15m, 1h or none
                  (default: 2m for a script, none for an agent)
  --notify LEVEL  what it tells the person: problems (only when it fails or
                  times out), results (and when it finishes with something to
                  say), all (and when it starts) or none. Default: problems
                  for a script, results for an agent
  --missed POLICY a time missed while Herdr was closed or the Mac slept: run
                  (once, if it was within 12 hours: the default), skip (never
                  late) or always (once, however late)
  --dedupe POLICY changed (the default: on a repeating time, a check that
                  prints the same as last time starts nothing) or always
  --secret-env VAR=NAME  (repeatable) the secret NAME as $VAR for the
                  script and the check, never the agent itself: an agent
                  automation needs a --check for it, and its prompt can name
                  a secret for herdr-ws-secret http or run instead. NAME
                  must be in Secrets (herdr-ws-secret list)
  --workspace ID  default: the workspace holding the current folder
  --global        for every workspace, not this one: it runs in each, in that
                  workspace's root (or --folder, from the root), unless the
                  workspace has its own automation of the same name. Only
                  when the person asks for all their workspaces
  prompt          the agent's whole task, or - to read it from stdin. The agent
                  starts fresh, without this conversation: say everything it
                  needs (what to check, where, what to do, how to report).
                  With --shell: the script, or - to read it from stdin.

  herdr-ws-run --off NAME       turn one off (the file stays); one that's for
                                every workspace goes off in this one only,
                                unless you add --global
  herdr-ws-run --on NAME        turn it back on; a one-time one whose time has
                                passed needs --at TIME, its new time
  herdr-ws-run --list           every automation, with its when: line
  herdr-ws-run WS NAME [text]   start one now

Times are this computer's clock. Herdr must be open, or its background runner on
(herdr-ws-runner --on): a run missed while neither ran or the Mac slept starts
when it can, if that's within 12 hours.

While Automations is off in Herdr's Settings > Features, none of them run, not
even a start from here (it's refused): what you add is kept and runs once
they're on again. What came due while they were off doesn't run late. Without
Node it can only say they may be off, and asks anyway.
EOF
}

# A front matter value as written, without its quotes.
front() { awk -v k="$2" 'NR == 1 && /^---[ \t\r]*$/ { h = 1; next } h && /^---[ \t\r]*$/ { exit }
  h && index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^[ \t]+/, "", v); sub(/[ \t\r]+$/, "", v); print v; exit }' "$1" |
  sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"; }

# The folder as the file system sees it (a root may be a symlink).
real() { (cd "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"; }
# $1 is $2 or inside it.
holds() { case "$1/" in "$2"/*) return 0 ;; esac; return 1; }

# The workspace holding folder $1: its most specific root or folder, or for a
# herdr worktree (~/.herdr/worktrees/<repo>/<branch>), its repo's. As herdr-ws-agent.
workspace_of() {
  [ -r "$index" ] || return 0
  found= best=-1
  while IFS=$tab read -r kind id path _; do
    [ "$kind" = dir ] || continue
    path=$(real "$path")
    if holds "$1" "$path" && [ ${#path} -gt $best ]; then found=$id; best=${#path}; fi
  done < "$index"
  trees=$(real "$HOME/.herdr/worktrees")
  if [ -z "$found" ] && holds "$1" "$trees"; then
    repo=${1#"$trees"/}
    repo=${repo%%/*}
    while IFS=$tab read -r kind id name _; do
      if [ "$kind" = repo ] && [ "$name" = "$repo" ]; then found=$id; break; fi
    done < "$index"
  fi
  printf '%s' "$found"
}
root_of() {
  [ -r "$index" ] || return 0
  while IFS=$tab read -r kind id path _; do
    if [ "$kind" = ws ] && [ "$id" = "$1" ]; then printf '%s' "$path"; return 0; fi
  done < "$index"
}

# Dates: BSD date (macOS), else GNU date.
# Today plus $1 days, as format $2.
day() { date -v+"$1"d +"$2" 2>/dev/null || date -d "+$1 days" +"$2"; }
# Epoch seconds $1 as format $2.
at_epoch() { date -r "$1" +"$2" 2>/dev/null || date -d "@$1" +"$2"; }
# "YYYY-MM-DD HH:MM" $1 as format $2.
fmt() { date -j -f "%Y-%m-%d %H:%M" "$1" +"$2" 2>/dev/null || date -d "$1" +"$2" 2>/dev/null; }
# $1 comes after $2 (both "YYYY-MM-DD HH:MM").
later() { [ "$(expr "x$1" \> "x$2")" = 1 ]; }

# "6am", "6:30pm", "18:30", "9": HH:MM.
clock() {
  t=$1 suf=
  case $t in *am|*pm) suf=${t#"${t%??}"}; t=${t%??} ;; esac
  case $t in *:*) h=${t%%:*} m=${t#*:} ;; *) h=$t m=00 ;; esac
  case "$h:$m" in *[!0-9:]*|:*|*:|*:*:*) return 1 ;; esac
  [ ${#h} -le 2 ] && [ ${#m} -eq 2 ] || return 1
  h=${h#0} m=${m#0}
  h=${h:-0} m=${m:-0}
  if [ -n "$suf" ]; then
    [ "$h" -ge 1 ] && [ "$h" -le 12 ] || return 1
    h=$((h % 12))
    [ "$suf" = am ] || h=$((h + 12))
  fi
  [ "$h" -le 23 ] && [ "$m" -le 59 ] || return 1
  printf '%02d:%02d' "$h" "$m"
}

weekday() {
  case $1 in
    sun|sunday) echo 0 ;; mon|monday) echo 1 ;; tue|tues|tuesday) echo 2 ;; wed|weds|wednesday) echo 3 ;;
    thu|thur|thurs|thursday) echo 4 ;; fri|friday) echo 5 ;; sat|saturday) echo 6 ;; *) return 1 ;;
  esac
}

# An --at TIME as "YYYY-MM-DD HH:MM". Fails 1 when it can't read it, 2 (printing
# the time) when it has passed.
resolve() {
  s=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | sed -e 's/^ *//' -e 's/ *$//' -e 's/  */ /g' \
    -e 's/^at //' -e 's/ at / /' -e 's/^on //' -e 's/^next //' -e 's/ next / /')
  now=$(date +"%Y-%m-%d %H:%M")
  n=$(printf '%s' "$s" | sed -n 's/^in \([0-9][0-9]*\) *\([a-z]*\)$/\1/p')
  if [ -n "$n" ]; then
    case $(printf '%s' "$s" | sed -n 's/^in [0-9]* *\([a-z]*\)$/\1/p') in
      m|min|mins|minute|minutes) secs=60 ;;
      h|hr|hrs|hour|hours) secs=3600 ;;
      d|day|days) secs=86400 ;;
      *) return 1 ;;
    esac
    x=$(at_epoch $(( $(date +%s) + n * secs )) "%Y-%m-%d %H:%M")
  else
    set -f
    # shellcheck disable=SC2086
    set -- $s
    set +f
    d= t=
    for w in "$@"; do
      if c=$(clock "$w"); then [ -z "$t" ] || return 1; t=$c; continue; fi
      [ -z "$d" ] || return 1
      case $w in
        today) d=0 ;;
        tomorrow) d=1 ;;
        [0-9][0-9][0-9][0-9]-*) d=date:$w ;;
        *) wd=$(weekday "$w") || return 1; d=wd:$wd ;;
      esac
    done
    [ -n "$t" ] || return 1
    case $d in
      "") x="$(day 0 %Y-%m-%d) $t"; later "$x" "$now" || x="$(day 1 %Y-%m-%d) $t" ;;
      date:*)
        given=$(printf '%s' "${d#date:}" | awk -F- 'NF == 3 { printf "%04d %02d %02d", $1, $2, $3 }')
        [ -n "$given" ] && [ "$(fmt "${d#date:} $t" "%Y %m %d")" = "$given" ] || return 1
        x="$(fmt "${d#date:} $t" "%Y-%m-%d") $t" ;;
      wd:*)
        i=0 x=
        while [ $i -le 7 ]; do
          if [ "$(day $i %w)" = "${d#wd:}" ]; then x="$(day $i %Y-%m-%d) $t"; later "$x" "$now" && break; fi
          i=$((i + 1))
        done ;;
      *) x="$(day "$d" %Y-%m-%d) $t" ;;
    esac
  fi
  printf '%s' "$x"
  later "$x" "$now" || return 2
}

# A front matter value in double quotes, on one line.
q() { printf '"%s"' "$(printf '%s' "$1" | tr '\r\n' '  ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }
# Key $1 with the lines of $2 as a YAML block ("check: |-", each line two spaces in; a first line
# that starts with a space says its indent, "|2-"), as autofacts.js reads and writes it.
block() {
  case $2 in [\ \	]*) echo "$1: |2-" ;; *) echo "$1: |-" ;; esac
  printf '%s\n' "$2" | awk '{ if ($0 ~ /[^ \t]/) print "  " $0; else print "" }'
}

# The global automation file $1 with workspace $2 in its off: line ($3 = add) or out of it.
set_here() {
  rest=$(front "$1" off | tr ',' '\n' | sed -e 's/^ *//' -e 's/ *$//' | awk -v w="$2" 'NF && $0 != w' | paste -sd, - | sed 's/,/, /g')
  [ "$3" != add ] || rest=${rest:+$rest, }$2
  awk -v v="$rest" 'NR == 1 && /^---[ \t\r]*$/ { h = 1; print; next }
       h && /^off[ \t]*:/ { next }
       h && /^---[ \t\r]*$/ { if (v != "") print "off: " v; h = 0 }
       { print }' "$1" > "$1.$$.tmp"
  mv "$1.$$.tmp" "$1"
}

case "${1:-}" in -h|--help) help; exit 0 ;; esac

if [ "${1:-}" = --list ]; then
  found=
  for f in "$dir"/*/automations/*.md; do
    [ -f "$f" ] || continue
    ws=${f#"$dir"/}
    name=${f##*/}
    off=
    case $(front "$f" enabled) in false|no|off|0) off="  (off)" ;; esac
    printf '%s %s  %s%s\n' "${ws%%/*}" "${name%.md}" "$(front "$f" when)" "$off"
    found=1
  done
  # Those for every workspace, as "*": a workspace's own of the same name replaces one there.
  for f in "$global"/*.md; do
    [ -f "$f" ] || continue
    name=${f##*/}
    off=
    case $(front "$f" enabled) in false|no|off|0) off="  (off)" ;; esac
    [ -n "$off" ] || { o=$(front "$f" off); [ -z "$o" ] || off="  (off in $o)"; }
    printf '* %s  %s%s\n' "${name%.md}" "$(front "$f" when)" "$off"
    found=1
  done
  [ -n "$found" ] || echo "No automations yet: add one with --add, or in Herdr's Automations screen."
  off_note "none of these run until they're on again."
  exit 0
fi

if [ "${1:-}" = --add ] || [ "${1:-}" = --off ] || [ "${1:-}" = --on ]; then
  mode=${1#--}
  shift
  at= when= name= agent= model= effort= folder= card= keep= wsid= desc= auto= check= glob=
  shell= terminal= timeout= notify= missed= dedupe= secrets=
  while [ $# -gt 0 ]; do
    case $1 in
      --at|--when|--name|--agent|--model|--effort|--folder|--workspace|--description|--check|--timeout|--notify|--missed|--dedupe)
        [ $# -ge 2 ] || die "$1 needs a value"
        case $1 in
          --at) at=$2 ;; --when) when=$2 ;; --name) name=$2 ;; --agent) agent=$2 ;;
          --model) model=$2 ;; --effort) effort=$2 ;;
          --folder) folder=$2 ;; --workspace) wsid=$2 ;; --description) desc=$2 ;; --check) check=$2 ;;
          --timeout) timeout=$2 ;; --notify) notify=$2 ;; --missed) missed=$2 ;; --dedupe) dedupe=$2 ;;
        esac
        shift 2 ;;
      --secret-env)
        [ $# -ge 2 ] || die "$1 needs VAR=name"
        printf '%s' "$2" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*=[a-z0-9][a-z0-9._-]{0,63}$' ||
          die "--secret-env is VAR=secret-name (STRIPE_KEY=stripe-test), not \"$2\""
        secrets=${secrets:+$secrets, }$2
        shift 2 ;;
      --shell)
        shell=bash
        case ${2:-} in bash|zsh|sh) shell=$2; shift ;; esac
        shift ;;
      --shell=*) shell=${1#--shell=}; shift ;;
      --terminal) terminal=1; shift ;;
      --card) card=1; shift ;;
      --keep) keep=1; shift ;;
      --global) glob=1; shift ;;
      --) shift; break ;;
      -) break ;;
      -*) die "unknown option $1
$usage" ;;
      *) if [ "$mode" != add ] && [ -z "$name" ]; then name=$1; shift; else break; fi ;;
    esac
  done

  cwd=$(pwd -P) fromcwd=
  if [ -n "$glob" ]; then
    [ -z "$wsid" ] || die "give --global or --workspace, not both"
    autos=$global where="every workspace"
  else
    [ -n "$wsid" ] || { wsid=$(workspace_of "$cwd"); fromcwd=1; }
    [ -n "$wsid" ] || die "this folder ($cwd) isn't in a Herdr workspace: run it from one, or pass --workspace <id> (ls ~/.herdr/workspaces)"
    case $wsid in */*|.*) die "\"$wsid\" is a workspace's folder name, not a path" ;; esac
    [ -d "$dir/$wsid" ] || die "there's no workspace \"$wsid\" (ls ~/.herdr/workspaces)"
    autos=$dir/$wsid/automations where=$wsid
  fi
  case $name in */*|.*) die "\"$name\" is a name, not a path" ;; esac

  # One that's for every workspace, turned off or on from inside a workspace: here only.
  if [ "$mode" != add ] && [ -z "$glob" ] && [ -n "$name" ] && [ ! -f "$autos/$name.md" ] && [ -f "$global/$name.md" ]; then
    [ -z "$at" ] || die "\"$name\" is for every workspace: --at would change it everywhere, so add --global"
    if [ "$mode" = off ]; then
      set_here "$global/$name.md" "$wsid" add
      echo "Turned off \"$name\" in $wsid. It's for every workspace and stays on in the others (--global turns it off everywhere). herdr-ws-run --on $name turns it back on here."
    else
      set_here "$global/$name.md" "$wsid" remove
      case $(front "$global/$name.md" enabled) in
        false|no|off|0) echo "\"$name\" is for every workspace and is off in all of them: herdr-ws-run --on $name --global turns it on." ;;
        *) echo "Turned on \"$name\" in $wsid ($(front "$global/$name.md" when))." ;;
      esac
    fi
    exit 0
  fi

  if [ "$mode" = off ]; then
    [ -n "$name" ] || die "which one? herdr-ws-run --list shows them"
    file=$autos/$name.md
    [ -f "$file" ] || die "there's no automation \"$name\" in $where (herdr-ws-run --list shows them)"
    tmp=$autos/.$name.$$.tmp
    awk 'NR == 1 && !/^---[ \t\r]*$/ { print "---"; print "enabled: false"; print "---" }
         NR == 1 && /^---[ \t\r]*$/ { h = 1; print; next }
         h && /^enabled[ \t]*:/ { next }
         h && /^---[ \t\r]*$/ { print "enabled: false"; h = 0 }
         { print }' "$file" > "$tmp"
    mv "$tmp" "$file"
    echo "Turned off \"$name\" in $where. herdr-ws-run --on $name${glob:+ --global} turns it back on."
    exit 0
  fi

  if [ "$mode" = on ]; then
    [ -n "$name" ] || die "which one? herdr-ws-run --list shows them"
    file=$autos/$name.md
    [ -f "$file" ] || die "there's no automation \"$name\" in $where (herdr-ws-run --list shows them)"
    cur=$(front "$file" when)
    once=
    case $cur in once\ *|ONCE\ *|Once\ *) once=1 ;; esac
    new=
    if [ -n "$at" ]; then
      [ -n "$once" ] || die "\"$name\" repeats ($cur): --at only gives a one-time automation a new time"
      set +e
      t=$(resolve "$at")
      r=$?
      set -e
      [ $r -ne 2 ] || die "\"$at\" ($t) has already passed"
      [ $r -eq 0 ] || die "can't read \"$at\" as a time: try \"tomorrow 6am\", \"in 2 hours\" or \"2026-11-12 06:00\""
      new="once $t"
    elif [ -n "$once" ]; then
      # Its time as written ("once 2026-11-12 06:00"): passed, it would never run.
      was=$(printf '%s' "${cur#* }" | sed -n 's/^\([0-9]\{4\}-[0-9][0-9]-[0-9][0-9]\) \([0-9][0-9]:[0-9][0-9]\)$/\1 \2/p')
      if [ -n "$was" ] && ! later "$was" "$(date +"%Y-%m-%d %H:%M")"; then
        die "\"$name\" ran once, at $was. Give it a new time: herdr-ws-run --on $name --at \"tomorrow 6am\""
      fi
    fi
    tmp=$autos/.$name.$$.tmp
    awk -v new="$new" 'NR == 1 && /^---[ \t\r]*$/ { h = 1; print; next }
         h && /^enabled[ \t]*:/ { next }
         h && new != "" && /^when[ \t]*:/ { print "when: \"" new "\""; next }
         h && /^---[ \t\r]*$/ { h = 0 }
         { print }' "$file" > "$tmp"
    mv "$tmp" "$file"
    if [ -n "$new" ]; then
      pretty=$(fmt "$t" "%a %d %b %Y at %H:%M" | sed 's/ 0\([0-9]\) / \1 /')
      echo "Turned on \"$name\" in $where: it runs once, ${pretty:-$t}, then turns itself off."
    else
      echo "Turned on \"$name\" in $where ($cur)."
    fi
    off_note "it won't run until they're on again."
    exit 0
  fi

  if [ -n "$shell" ]; then
    case $shell in bash|zsh|sh) ;; *) die "--shell is bash, zsh or sh, not \"$shell\"" ;; esac
    [ -z "$agent$model$effort" ] || die "a --shell automation runs its script without an agent: leave out --agent, --model and --effort"
    [ -z "$card" ] || die "a --shell automation has no agent to give a card to: leave out --card"
  else
    [ -z "$terminal" ] || die "--terminal is for a --shell automation (a script shown in a tab)"
    [ -z "$secrets" ] || [ -n "$check" ] || die "--secret-env reaches a --check or a --shell script, never the agent itself: give a --check, or let the prompt name the secret for herdr-ws-secret http or run"
  fi
  case $timeout in
    ""|none|off|0) ;;
    *) printf '%s' "$timeout" | grep -Eq '^([0-9]+ *(s|sec|secs|seconds?|m|min|mins|minutes?|h|hr|hrs|hours?) *)+$' ||
         die "--timeout is a length of time: 30s, 2m, 15m, 1h or none" ;;
  esac
  case $notify in ""|problems|results|all|none) ;; *) die "--notify is problems, results, all or none" ;; esac
  case $missed in ""|run|skip|always) ;; *) die "--missed is run, skip or always" ;; esac
  case $dedupe in ""|changed|always) ;; *) die "--dedupe is changed or always" ;; esac
  # A check over several lines: no blank lines at its ends, no carriage returns.
  check=$(printf '%s\n' "$check" | tr -d '\r' | awk 'NF { last = NR } { line[NR] = $0 } END { for (i = 1; i <= last; i++) if (started || line[i] ~ /[^ \t]/) { started = 1; print line[i] } }')
  [ -n "$at$when" ] || die "say when: --at TIME (once) or --when LINE (repeating); --help has examples"
  [ -z "$at" ] || [ -z "$when" ] || die "give --at or --when, not both"
  if [ $# -eq 1 ] && [ "$1" = - ]; then prompt=$(cat); else prompt=$*; fi
  if [ -n "$shell" ]; then
    [ -n "$(printf '%s' "$prompt" | tr -d ' \t\r\n')" ] || die "what should the script do? Give it last, or - to read it from stdin"
  else
    [ -n "$(printf '%s' "$prompt" | tr -d ' \t\r\n')" ] || die "what should the agent do? Give the prompt last, or - to read it from stdin"
  fi

  if [ -n "$at" ]; then
    set +e
    t=$(resolve "$at")
    r=$?
    set -e
    [ $r -ne 2 ] || die "\"$at\" ($t) has already passed"
    [ $r -eq 0 ] || die "can't read \"$at\" as a time: try \"tomorrow 6am\", \"today 18:30\", \"in 2 hours\", \"monday 9am\" or \"2026-11-12 06:00\""
    when="once $t"
    if [ -z "$name" ]; then name="once-$(printf '%s' "$t" | tr -d ':' | tr ' ' '-')"; auto=1; fi
  else
    case " $when " in
      *" today "*|*" tomorrow "*|" in "*|" once "*) die "\"$when\" happens once: use --at" ;;
    esac
  fi
  [ -n "$name" ] || die "give a repeating automation a --name"
  case $name in -*|*[!A-Za-z0-9_-]*) die "a name is letters, digits, - and _" ;; esac

  if [ -n "$agent" ]; then
    case $agent in */*|.*) die "\"$agent\" is a preset or program name, not a path" ;; esac
    [ -f "$dir/$wsid/agents/$agent.md" ] || [ -f "$templates/$agent.md" ] || command -v "$agent" >/dev/null 2>&1 ||
      die "there's no preset or program \"$agent\" (herdr-ws-agent --presets lists the presets)"
  fi

  for v in "$model" "$effort"; do
    case $v in *[!A-Za-z0-9._:/@-]*) die "\"$v\" isn't a model or effort name" ;; esac
  done

  # Where it runs: --folder, else this folder when it's in the workspace, else
  # the root. Written from the root when it's under it, else in full.
  if [ -n "$glob" ]; then
    # Each workspace has its own folders: only one written from the root can hold in all of them.
    case $folder in /*|"~"*) die "one for every workspace runs in each workspace's root: give --folder from the root (api), or leave it out" ;; esac
    rel=$folder
  else
    root=$(root_of "$wsid")
    [ -z "$root" ] || root=$(real "$root")
    if [ -n "$folder" ]; then
      place=$(cd "$folder" 2>/dev/null && pwd -P) || die "there's no folder \"$folder\""
    else
      place=$cwd
    fi
    if [ -n "$root" ] && [ "$place" = "$root" ]; then rel=
    elif [ -n "$root" ] && holds "$place" "$root"; then rel=${place#"$root"/}
    elif [ -n "$folder" ] || [ -n "$fromcwd" ]; then rel=$place
    else rel=
    fi
  fi

  mkdir -p "$autos"
  file=$autos/$name.md
  if [ -e "$file" ]; then
    [ -n "$auto" ] || die "there's already an automation \"$name\" in $where: pick another --name"
    n=2
    while [ -e "$autos/$name-$n.md" ]; do n=$((n + 1)); done
    name=$name-$n
    file=$autos/$name.md
  fi
  [ -n "$desc" ] || desc=$(printf '%s\n' "$prompt" | sed -n '/[^[:space:]]/{p;q;}' | sed -E 's/^[[:space:]]+//; s/^(.{77}).+$/\1…/')

  # Written aside, then moved in, so Herdr never reads half a file.
  tmp=$autos/.$name.$$.tmp
  {
    echo ---
    echo "description: $(q "$desc")"
    echo "when: $(q "$when")"
    [ -z "$agent" ] || echo "agent: $(q "$agent")"
    [ -z "$model" ] || echo "model: $model"
    [ -z "$effort" ] || echo "effort: $effort"
    [ -z "$rel" ] || echo "folder: $(q "$rel")"
    if [ -n "$shell" ]; then
      echo "run: shell"
      echo "shell: $shell"
      [ -z "$terminal" ] || echo "terminal: true"
    fi
    [ -z "$timeout" ] || echo "timeout: $timeout"
    [ -z "$notify" ] || echo "notify: $notify"
    [ -z "$missed" ] || echo "missed: $missed"
    [ -z "$dedupe" ] || echo "dedupe: $dedupe"
    [ -z "$secrets" ] || echo "secret_env: $secrets"
    case $check in
      "") ;;
      *"
"*) block check "$check" ;;
      *) echo "check: $(q "$check")" ;;
    esac
    [ -z "$card" ] || echo "card: true"
    [ -z "$keep" ] || echo "keep: true"
    echo ---
    printf '%s\n' "$prompt"
  } > "$tmp"
  mv "$tmp" "$file"

  if [ -n "$at" ]; then
    pretty=$(fmt "$t" "%a %d %b %Y at %H:%M" | sed 's/ 0\([0-9]\) / \1 /')
    echo "Added \"$name\" in $where: it runs once, ${pretty:-$t}, then turns itself off."
  else
    echo "Added \"$name\" in $where: \"$when\". If Herdr can't read that line, its Automations screen says why."
  fi
  knobs=$model
  [ -z "$effort" ] || knobs="${knobs:+$knobs, }$effort effort"
  if [ -n "$shell" ]; then
    seen="unseen (what it prints goes to History)"
    [ -z "$terminal" ] || seen="in a tab of the workspace's Automations space"
    if [ -n "$glob" ]; then echo "In each workspace it runs its $shell script in ${rel:-the root}, $seen, with no agent. A workspace's own automation called \"$name\" replaces it there."
    else echo "It runs its $shell script in ${rel:-the workspace root}, $seen, with no agent."; fi
  elif [ -n "$glob" ]; then
    who=$agent
    [ -n "$who" ] || who="that board's agent"
    echo "In each workspace it starts $who${knobs:+ ($knobs)} in ${rel:-the root}, in a tab of the workspace's Automations space. A workspace's own automation called \"$name\" replaces it there."
  else
    echo "It starts ${agent:-the default agent}${knobs:+ ($knobs)} in ${rel:-the workspace root}, in a tab of the workspace's Automations space."
  fi
  what="the agent starts"
  [ -z "$shell" ] || what="the script runs"
  [ -z "$check" ] || echo "Each time, Herdr first runs its check there: $what only if that prints something."
  if [ -n "$secrets" ]; then
    who="Its script and its check get"
    [ -n "$shell" ] || who="Its check gets (the agent itself doesn't)"
    echo "$who these secrets as variables, through herdr-ws-secret: $secrets. A name Secrets doesn't have stops it, and its Automations screen says so. For a Protected one, macOS asks the person once when it first runs (and again when it changes): tell them."
  fi
  if [ -n "$shell" ]; then
    echo "The script needs the person's OK before it runs: Herdr asks them with a toast now, and Automations has Allow this script${check:+ (and Allow this check)}. Until then this automation doesn't start. Tell them."
  elif [ -n "$check" ]; then
    echo "The check needs the person's OK before it runs: Herdr asks them with a toast now, and Automations has Allow this check. Until then this automation doesn't start. Tell them."
  fi
  echo "File: $file"
  if [ -n "$glob" ]; then echo "To cancel: herdr-ws-run --off $name --global"
  else echo "To cancel: herdr-ws-run --off $name --workspace $wsid"; fi
  if automations_off; then
    echo "$off_words: it's kept, and doesn't run until they're on again (a time that passes meanwhile doesn't run late). Tell the person." >&2
  elif [ -n "$maybe_off" ]; then
    echo "$maybe_words. If they are, it's kept, and doesn't run until they're on again. Tell the person." >&2
  else
    herdr-app status >/dev/null 2>&1 || [ "$(cat "$HOME/.herdr/runner/switch" 2>/dev/null)" = on ] ||
      echo "Herdr isn't open: it has to be open then (a run missed while it's closed starts when it opens, within 12 hours)." >&2
  fi
  exit 0
fi

[ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }
ws=$1 name=$2
shift 2
case "$ws/$name" in
  */*/*|.*|*/.*) echo "herdr-ws-run: \"$ws\" and \"$name\" are names, not paths" >&2; exit 2 ;;
esac
[ -f "$dir/$ws/automations/$name.md" ] || { [ -d "$dir/$ws" ] && [ -f "$global/$name.md" ]; } || {
  echo "herdr-ws-run: there's no automation \"$name\" in \"$ws\" (herdr-ws-run --list shows them)" >&2
  exit 1
}
if [ $# -eq 1 ] && [ "$1" = - ]; then text=$(cat); else text=$*; fi

# Off in Settings > Features: nothing starts, so nothing is asked (it wouldn't run later either).
if automations_off; then
  echo "herdr-ws-run: $off_words, so $name didn't start and won't start later. Turn them on there (or take \"automations\": false out of ~/.herdr/settings.jsonc), then run this again." >&2
  exit 3
fi
[ -z "$maybe_off" ] || echo "herdr-ws-run: $maybe_words. If they are, Herdr won't start $name and notes it as skipped; asking anyway." >&2

# Written aside, then moved in, so Herdr never reads half a call.
mkdir -p "$dir/.inbox"
stamp=$(date +%s)
call="$dir/.inbox/$stamp-$$"
printf '%s\n%s\n%s000\n%s\n' "$ws" "$name" "$stamp" "$text" > "$call.tmp"
mv "$call.tmp" "$call.run"

if herdr-app status >/dev/null 2>&1 || [ "$(cat "$HOME/.herdr/runner/switch" 2>/dev/null)" = on ]; then
  echo "Asked Herdr to start $name in $ws."
else
  echo "Herdr isn't open: $name starts when it opens, if that's within an hour." >&2
fi
