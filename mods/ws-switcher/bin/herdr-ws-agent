#!/bin/sh
# Start an agent with its Herdr workspace's instructions.
#
#   herdr-ws-agent [--instructions FILE]... [--task TEXT] <agent> [args...]
#   herdr-ws-agent --preset NAME [task...]     start a preset here (as Herdr's UI does)
#   herdr-ws-agent --presets                   list the presets this folder's workspace offers
#
# Finds the workspace whose root or folders hold the current folder (a herdr
# worktree goes by its repo's name) and starts the agent with:
#
#   claude: --append-system-prompt <instructions> --add-dir <root, outside folders>
#   codex:  -c developer_instructions=<instructions> --add-dir <...>
#
# The instructions are the workspace's AGENTS.md (or its "instructions" file)
# without HTML comments; an empty one adds nothing. Inside a workspace a last
# line says how to leave work for later (herdr-ws-run --add), when that's on PATH.
# Any other agent, or a folder outside every workspace, runs unchanged. The workspaces come from the index
# the ws-switcher mod keeps in ~/.herdr/workspaces/.index while Herdr runs.
#
# --instructions FILE adds a preset's instructions after the workspace's (its
# body: front matter between --- lines and HTML comments left out), in or out of
# a workspace, under a line naming the preset (the file's name without .md), so
# the agent knows which one it is. The switcher and the board pass it when they
# start a preset.
#
# --task TEXT is the agent's first message, last on its command line. Herdr would
# put a tab's task there itself; given apart, it stays out of the note below.
#
# --preset NAME finds the preset (the workspace's agents/NAME.md, else herdr-core's
# templates/NAME.md) and runs its command: Claude and Codex with --instructions,
# any other agent with its instructions and the task as its first message. It's
# how an agent starts a workspace's own preset as its helper, which `hc run NAME`
# can't (hc only knows the templates):
#   hc run --bg --keep --name review --cwd <repo> herdr-ws-agent --preset reviewer "<task>"
# With --keep a restart brings it back (see herdr-ws-resume). The preset's
# command is read as the shell reads it (eval): it's your own config.
#
# Point Herdr's programs.json at it so the + menu starts agents this way:
#   { "programs": { "claude": { "run": ["herdr-ws-agent", "claude"] },
#                   "codex":  { "run": ["herdr-ws-agent", "codex", "--no-daemon"] } } }
#
# In a herdr-core terminal, Claude also gets a hook (in --settings) and its command
# a note in ~/.herdr/resume/<core>/<terminal>.cmd, so herdr-ws-resume brings it
# back after a restart, in the same tab.
#
# HERDR_WS_AGENT_DRY=1 prints the command, one word per line, instead of running it.

usage="usage: herdr-ws-agent [--instructions FILE]... [--task TEXT] <agent> [args...]
       herdr-ws-agent --preset NAME [task...]
       herdr-ws-agent --presets"
presets= mode= pname= agent= task=
case "${1:-}" in
  --presets) mode=list; shift ;;
  --preset) [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; mode=preset; pname=$2; shift 2 ;;
esac
if [ -z "$mode" ]; then
  while [ "${1:-}" = --instructions ] || [ "${1:-}" = --task ]; do
    [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }
    if [ "$1" = --task ]; then task=$2; else presets="$presets$2
"; fi
    shift 2
  done
  [ $# -ge 1 ] || { echo "$usage" >&2; exit 2; }
  agent=$1
  shift
fi
# The words that start this again after a restart (herdr-ws-resume): Claude's
# command without its prompt (the first message, sent once) and without a session
# to resume, which herdr-ws-resume adds. As Claude reads its words: the flags in
# $bare take no value, those in $many every word up to the next flag, any other
# flag the next word; a word no flag takes is the prompt.
bare=" --allow-dangerously-skip-permissions --ax-screen-reader --bg --background --bare --brief --chrome --no-chrome --dangerously-skip-permissions --desktop --disable-slash-commands --exclude-dynamic-system-prompt-sections --forward-subagent-text --ide --include-hook-events --include-partial-messages --no-session-persistence -p --print --replay-user-messages --restricted --safe-mode --strict-mcp-config --verbose "
many=" --add-dir --allowedTools --allowed-tools --betas --disallowedTools --disallowed-tools --file --mcp-config --tools "
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
note=herdr-ws-agent skip= take=
while IFS= read -r f; do
  [ -n "$f" ] && note="$note --instructions $(q "$f")"
done <<EOF
$presets
EOF
note="$note $(q "$agent")"
for w in "$@"; do
  if [ -n "$skip" ]; then skip=; case "$w" in -*) ;; *) continue ;; esac; fi
  if [ "$take" = one ]; then take=; case "$w" in -*) ;; *) note="$note $(q "$w")"; continue ;; esac; fi
  if [ "$take" = all ]; then case "$w" in -*) take= ;; *) note="$note $(q "$w")"; continue ;; esac; fi
  [ "$take" = rest ] && continue
  case "$w" in
    --) take=rest; continue ;;
    --resume | -r | --session-id) skip=1; continue ;;
    --resume=* | --session-id=* | --continue | -c | --fork-session) continue ;;
    --*=*) ;;
    -*) case "$bare" in *" $w "*) ;; *) case "$many" in *" $w "*) take=all ;; *) take=one ;; esac ;; esac ;;
    *) continue ;;
  esac
  note="$note $(q "$w")"
done

index=$HOME/.herdr/workspaces/.index
trees=$HOME/.herdr/worktrees
tab=$(printf '\t')
cwd=$(pwd -P)

# The folder as the file system sees it (a root may be a symlink).
real() { (cd "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"; }
# $1 is $2 or inside it.
holds() { case "$1/" in "$2"/*) return 0 ;; esac; return 1; }

ws= root= instructions=
if [ -r "$index" ]; then
  # The most specific root or folder holding this folder.
  best=-1
  while IFS=$tab read -r kind id path _; do
    [ "$kind" = dir ] || continue
    path=$(real "$path")
    if holds "$cwd" "$path" && [ ${#path} -gt $best ]; then ws=$id; best=${#path}; fi
  done < "$index"
  # A herdr worktree (~/.herdr/worktrees/<repo>/<branch>) goes by its repo.
  if [ -z "$ws" ] && holds "$cwd" "$(real "$trees")"; then
    repo=${cwd#"$(real "$trees")"/}
    repo=${repo%%/*}
    while IFS=$tab read -r kind id name _; do
      if [ "$kind" = repo ] && [ "$name" = "$repo" ]; then ws=$id; break; fi
    done < "$index"
  fi
  if [ -n "$ws" ]; then
    while IFS=$tab read -r kind id path file; do
      if [ "$kind" = ws ] && [ "$id" = "$ws" ]; then root=$path; instructions=$file; break; fi
    done < "$index"
  fi
fi

# A file's instructions: without front matter (--- lines at the top), without
# <!-- comments -->, and without blank lines at either end.
told() {
  awk 'NR == 1 && /^---[ \t\r]*$/ { head = 1; next }
       head && /^---[ \t\r]*$/ { head = 0; next }
       !head { s = s $0 "\n" }
       END {
         while ((i = index(s, "<!--")) > 0) {
           rest = substr(s, i + 4); j = index(rest, "-->")
           s = substr(s, 1, i - 1) (j ? substr(rest, j + 3) : "")
         }
         sub(/^[ \t\r\n]+/, "", s); sub(/[ \t\r\n]+$/, "", s); printf "%s", s }' "$1"
}

templates=${XDG_CONFIG_HOME:-$HOME/.config}/herdr-core/templates
wsdir=$HOME/.herdr/workspaces/$ws
# A front matter field of a preset file.
front() { awk -v k="$2" 'NR == 1 && /^---[ \t\r]*$/ { h = 1; next } h && /^---[ \t\r]*$/ { exit }
  h && index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^[ \t]+/, "", v); sub(/[ \t\r]+$/, "", v); print v; exit }' "$1"; }

if [ "$mode" = list ]; then
  own=" "
  if [ -n "$ws" ] && [ -d "$wsdir/agents" ]; then
    echo "Only in this workspace ($ws):"
    for f in "$wsdir"/agents/*.md; do
      [ -f "$f" ] || continue
      n=${f##*/}; n=${n%.md}
      printf '  %-16s %s\n' "$n" "$(front "$f" description)"
      own="$own$n "
    done
  fi
  echo "Every workspace:"
  for f in "$templates"/*.md; do
    [ -f "$f" ] || continue
    n=${f##*/}; n=${n%.md}
    case "$own" in
      *" $n "*) printf '  %-16s %s\n' "$n" "(this workspace's own $n is the one that runs)" ;;
      *) printf '  %-16s %s\n' "$n" "$(front "$f" description)" ;;
    esac
  done
  echo
  echo "Start one: hc run --bg --keep --name <name> --cwd <folder> herdr-ws-agent --preset <preset> \"<task>\""
  exit 0
fi

if [ "$mode" = preset ]; then
  case "$pname" in */*|.*|'') echo "herdr-ws-agent: \"$pname\" is a preset's name, not a path" >&2; exit 2 ;; esac
  file=
  if [ -n "$ws" ] && [ -f "$wsdir/agents/$pname.md" ]; then file=$wsdir/agents/$pname.md
  elif [ -f "$templates/$pname.md" ]; then file=$templates/$pname.md
  else echo "herdr-ws-agent: there's no preset \"$pname\" here (herdr-ws-agent --presets lists them)" >&2; exit 1
  fi
  task=$*
  line=$(front "$file" command)
  [ -n "$line" ] || { echo "herdr-ws-agent: $file has no command" >&2; exit 1; }
  eval "set -- $line"
  [ "${1:-}" = env ] && shift
  while [ $# -gt 0 ]; do
    case "$1" in [A-Za-z_]*=*) export "${1%%=*}=${1#*=}"; shift ;; *) break ;; esac
  done
  [ "${1##*/}" = herdr-ws-agent ] && shift
  [ $# -ge 1 ] || { echo "herdr-ws-agent: $file's command names no program" >&2; exit 1; }
  case "${1##*/}" in
    claude|codex)
      [ -n "$task" ] && exec "$0" --task "$task" --instructions "$file" "$@"
      exec "$0" --instructions "$file" "$@"
      ;;
  esac
  # Any other agent: its instructions, then the task, as its first message (as hc does).
  body=$(told "$file")
  first=
  [ -n "$body" ] && first="You are the \"$pname\" agent, started from the Herdr agent preset of that name ($file). Its instructions:

$body"
  [ -n "$task" ] && first=${first:+$first

}$task
  [ -n "$first" ] && set -- "$@" "$first"
  if [ -n "${HERDR_WS_AGENT_DRY:-}" ]; then
    printf 'workspace: %s\n' "${ws:-none}"
    printf '%s\n' "$@"
    exit 0
  fi
  exec "$@"
fi

# Extra words go before the caller's: append them, then rotate the caller's to the end.
given=$#
name=${agent##*/}
if [ "$name" = claude ] || [ "$name" = codex ]; then
  # The workspace's instructions, then each preset's, a blank line apart.
  text=
  [ -n "$ws" ] && [ -r "$instructions" ] && text=$(told "$instructions")
  while IFS= read -r file; do
    [ -n "$file" ] && [ -r "$file" ] || continue
    more=$(told "$file")
    [ -n "$more" ] || continue
    # Named, so the agent can say which preset it is.
    preset=${file##*/}
    more="You are the \"${preset%.md}\" agent, started from the Herdr agent preset of that name ($file). Its instructions:

$more"
    text=${text:+$text

}$more
  done <<EOF
$presets
EOF
  # In a workspace, the agent can leave work for later: a Herdr automation.
  if [ -n "$ws" ] && command -v herdr-ws-run >/dev/null 2>&1; then
    later="You're working in the Herdr workspace \"$ws\". When you're asked to do something later or on a schedule (\"tomorrow at 6, check X and if so do Y\"), set it up as a Herdr automation with herdr-ws-run --add; run herdr-ws-run --help first. It starts a new agent at that time, so its prompt must say everything that agent needs."
    text=${text:+$text

}$later
  fi
  if [ -n "$text" ]; then
    if [ "$name" = claude ]; then
      set -- "$@" --append-system-prompt "$text"
    else
      # A TOML string: backslashes and quotes escaped, lines joined with \n.
      toml=$(printf '%s\n' "$text" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r$//' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }')
      set -- "$@" -c "developer_instructions=\"$toml\""
    fi
  fi
  # The whole workspace is the agent's to read and edit, and its folders that live elsewhere.
  if [ -n "$ws" ]; then
    realroot=$(real "$root")
    [ -d "$root" ] && [ "$realroot" != "$cwd" ] && set -- "$@" --add-dir "$root"
    while IFS=$tab read -r kind id path _; do
      [ "$kind" = dir ] && [ "$id" = "$ws" ] && [ -d "$path" ] || continue
      p=$(real "$path")
      holds "$p" "$realroot" || [ "$p" = "$cwd" ] || set -- "$@" --add-dir "$path"
    done < "$index"
  fi
fi

# Brought back after a restart (herdr-ws-resume): in a herdr-core terminal, Claude
# gets hooks that note its session, and its command is noted. The hooks go into the
# command's own inline --settings, since a second --settings would replace it; a
# --settings file, or settings with hooks of their own, leave it out of restarts.
self=$0
[ -L "$self" ] && link=$(readlink "$self") && case "$link" in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
resume=$(dirname "$self")/herdr-ws-resume
[ -x "$resume" ] || resume=$(command -v herdr-ws-resume 2>/dev/null) || resume=
# Off (herdr-ws-resume --off, or the Agent presets screen): no hooks, no note.
switch=${HERDR_WS_RESUME_DIR:-$HOME/.herdr/resume}/switch
hooks=
if [ "$name" = claude ] && [ -n "$resume" ] && [ "$(sed -n 1p "$switch" 2>/dev/null)" != off ] && [ -n "${HC_TERMINAL_ID:-}" ] && [ -n "${HC_TERMINAL_SOCKET:-}" ]; then
  hook=$(printf '%s' "'$resume' --hook" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
  hooks="{\"SessionStart\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"$hook\",\"timeout\":10}]}],\"SessionEnd\":[{\"matcher\":\"prompt_input_exit|logout\",\"hooks\":[{\"type\":\"command\",\"command\":\"$hook\",\"timeout\":10}]}]}"
fi
# Inline settings JSON with the hooks added, or false.
withhooks() {
  case "$1" in *'"hooks"'*) return 1 ;; esac
  rest=$(printf '%s' "$1" | sed '1s/^[[:space:]]*{//')
  [ "$rest" != "$1" ] || return 1
  case "$(printf '%s' "$rest" | sed '1s/^[[:space:]]*//')" in
    '}'*) printf '{"hooks":%s%s' "$hooks" "$rest" ;;
    *) printf '{"hooks":%s,%s' "$hooks" "$rest" ;;
  esac
}

# Rotate: the caller's words (the first $given) move after the extras.
i=0 prev= merged=
while [ $i -lt "$given" ]; do
  w=$1
  if [ -n "$hooks" ] && [ -z "$merged" ]; then
    if [ "$prev" = --settings ]; then
      if m=$(withhooks "$w"); then w=$m merged=1; else hooks=; fi
    else
      case "$w" in --settings=*) if m=$(withhooks "${w#--settings=}"); then w=--settings=$m merged=1; else hooks=; fi ;; esac
    fi
  fi
  set -- "$@" "$w"
  shift
  prev=$w
  i=$((i + 1))
done

if [ -n "$hooks" ]; then
  [ -n "$merged" ] || set -- "$@" --settings "{\"hooks\":$hooks}"
  if [ -z "${HERDR_WS_AGENT_DRY:-}" ]; then
    core=${HC_TERMINAL_SOCKET##*/}
    notes=${HERDR_WS_RESUME_DIR:-$HOME/.herdr/resume}/${core%.sock}
    if mkdir -p "$notes" 2>/dev/null; then
      rm -f "$notes/$HC_TERMINAL_ID.session"
      printf '%s\n' "$note" > "$notes/$HC_TERMINAL_ID.cmd"
      # Drop the notes of terminals that are gone (their tab was closed).
      if command -v hc >/dev/null 2>&1; then
        (live=$(hc ls --json 2>/dev/null) || exit 0
          case "$live" in *'"address"'*) ;; *) exit 0 ;; esac
          for f in "$notes"/*.cmd; do
            [ -f "$f" ] || continue
            t=${f##*/}; t=${t%.cmd}
            [ "$t" = "$HC_TERMINAL_ID" ] && continue
            case "$live" in *"\"address\":\"$t\""*) ;; *) rm -f "$f" "${f%.cmd}.session" ;; esac
          done) >/dev/null 2>&1 &
      fi
    fi
  fi
fi
[ -n "$task" ] && set -- "$@" "$task"

if [ -n "${HERDR_WS_AGENT_DRY:-}" ]; then
  printf 'workspace: %s\n' "${ws:-none}"
  printf '%s\n' "$agent" "$@"
  exit 0
fi
exec "$agent" "$@"
