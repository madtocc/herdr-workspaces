#!/bin/sh
# Start an agent with its Herdr workspace's instructions.
#
#   herdr-ws-agent [--instructions FILE]... [--task TEXT] <agent> [args...]
#   herdr-ws-agent --preset NAME [task...]     start a preset here (as Herdr's UI does)
#   herdr-ws-agent --presets                   list the presets this folder's workspace offers
#
# Finds the workspace whose root or folders hold the current folder (a herdr
# worktree goes by its repo's name) and starts the agent with:
#
#   claude: --append-system-prompt <instructions> --add-dir <root, outside folders>
#           --settings <its tasks and notes folders as permissions.additionalDirectories>
#   codex:  -c developer_instructions=<instructions> --add-dir <root, outside folders, its tasks and notes folders>
#   agy:    --add-dir <a folder of Herdr's own that holds the instructions as AGENTS.md>
#           --add-dir <root, outside folders, its tasks and notes folders>
#   pi:     --append-system-prompt <instructions, naming root, outside folders, its tasks and notes folders>
#
# Antigravity's CLI (agy) takes no instructions on its command line. It reads
# AGENTS.md, and .agents/rules/*.md, from every folder it's given with --add-dir, as
# rules beside the repo's own, at every turn and again when a conversation is resumed.
# So its instructions are written to ~/.herdr/agy/<workspace or _>/<the text's checksum>/,
# and a folder no launch has used for 90 days is removed. agy cuts a rule file at
# 24,000 bytes, so a longer text goes on in .agents/rules/herdr-N.md. agy also runs
# commands in the first of its folders by path, whichever it was started in, so the
# text names its working folder. Its first message goes in with -i. The folder also
# holds .agents/hooks.json, which agy runs too: the hook that notes its conversation
# for a restart (herdr-ws-resume), as Claude's --settings hooks do.
#
# Pi (pi) has no --add-dir and no sandbox of its own: it can reach every folder, so
# its text names the workspace's. It reads AGENTS.md (or CLAUDE.md) from its working
# folder and every folder above it itself, so a guide or instructions file it would
# read that way is left out of the text (unless it's started with --no-context-files).
# A --append-system-prompt replaces the APPEND_SYSTEM.md it would find, so its own
# one (~/.pi/agent, or $PI_CODING_AGENT_DIR) is passed first, and a folder's
# .pi/APPEND_SYSTEM.md is pointed at. Its first message goes in after --, so one
# starting with - or @ (a file to Pi) is still a message.
#
# Claude asks at every start whether to trust a folder given with --add-dir that
# it hasn't been told to trust (since 2.1.326), and waits for the answer. Herdr's
# own folders (under ~/.herdr: a workspace's tasks, the Scratch root) are never
# ones Claude was started in, so Claude gets those through its settings instead,
# which lets it read and edit there and asks nothing. They share the command's own
# inline --settings; with a --settings file, or settings that already name
# additionalDirectories, they stay --add-dir.
#
# The instructions are the workspace's AGENTS.md (or its "instructions" file)
# without HTML comments; an empty one adds nothing. Inside a workspace a last
# line says how to leave work for later (herdr-ws-run --add), when that's on PATH.
# Any other agent, or a folder outside every workspace, runs unchanged. The workspaces come from the index
# the ws-switcher mod keeps in ~/.herdr/workspaces/.index while Herdr runs.
#
# ~/.herdr/AGENTS.md, when it's there, is the global guide: what every agent
# started this way should know about Herdr (automations, hc helpers, the board).
# Claude, Codex, Antigravity and Pi get it first, before the workspace's instructions, in or out of
# a workspace (up to 16 KB, else a line naming the file). It replaces the built-in
# line about herdr-ws-run; inside a workspace they're then told its name instead.
# --guide off (or the switch in the Agent presets screen) leaves it out for every
# agent, --guide on puts it back, --guide status says which. A preset with
# guide: off in its front matter goes without it. Without it, agents get what they
# would with no guide, the herdr-ws-run line included.
#
# A workspace can also hold a BRIEF.md beside its AGENTS.md: where its work stands
# right now (what happened lately, what's open), kept by whatever knows: an
# automation, a script, you. AGENTS.md is what holds always; the brief is what
# holds today. An agent started with no preset is yours to talk to and gets the
# brief whole after the instructions (up to 16 KB; front matter and HTML comments
# left out). A preset's agent has a job of its own, so it's only told where the
# file is. No BRIEF.md, or an empty one, adds nothing.
#
# --instructions FILE adds a preset's instructions after the workspace's (its
# body: front matter between --- lines and HTML comments left out), in or out of
# a workspace, under a line naming the preset (the file's name without .md), so
# the agent knows which one it is. The switcher and the board pass it when they
# start a preset.
#
# --task TEXT is the agent's first message, last on its command line. Herdr would
# put a tab's task there itself; given apart, it stays out of the note below.
#
# --preset NAME finds the preset (the workspace's agents/NAME.md, else herdr-core's
# templates/NAME.md) and runs its command: Claude, Codex, Antigravity and Pi with --instructions,
# any other agent with its instructions and the task as its first message. It's
# how an agent starts a workspace's own preset as its helper, which `hc run NAME`
# can't (hc only knows the templates):
#   hc run --bg --keep --name review --cwd <repo> herdr-ws-agent --preset reviewer "<task>"
# With --keep a restart brings it back (see herdr-ws-resume). The preset's
# command is read as the shell reads it (eval): it's your own config.
#
# Point Herdr's programs.json at it so the + menu starts agents this way:
#   { "programs": { "claude": { "run": ["herdr-ws-agent", "claude"] },
#                   "codex":  { "run": ["herdr-ws-agent", "codex", "--no-daemon"] },
#                   "pi":     { "run": ["herdr-ws-agent", "pi"] } } }
#
# In a herdr-core terminal, Claude also gets a hook (in --settings) and its command
# a note in ~/.herdr/resume/<core>/<terminal>.cmd, so herdr-ws-resume brings it
# back after a restart, in the same tab. Its status line (in the same --settings) is
# herdr-ws-statusline, which keeps the model, context and limits Claude hands it for
# the Agents list, unless a status line is set already.
#
# Started from another agent's terminal (an hc helper), it also has herdr-ws-resume
# --parent note which terminal started it, in the background, so the History screen
# can fold the helper's conversation under the one that started it.
#
# HERDR_WS_AGENT_DRY=1 prints the command, one word per line, instead of running it.

usage="usage: herdr-ws-agent [--instructions FILE]... [--task TEXT] <agent> [args...]
       herdr-ws-agent --preset NAME [task...]
       herdr-ws-agent --presets
       herdr-ws-agent --guide on|off|status"
presets= mode= pname= agent= task=
# The global guide's switch: off is "off" in ~/.herdr/guide/switch; anything else is on.
guide=$HOME/.herdr/AGENTS.md
switch=$HOME/.herdr/guide/switch
guide_on() { [ "$(sed -n 1p "$switch" 2>/dev/null)" != off ]; }
if [ "${1:-}" = --guide ]; then
  case "${2:-status}" in
    on | off) mkdir -p "${switch%/*}" && printf '%s\n' "$2" > "$switch" || exit 1 ;;
    status) ;;
    *) echo "$usage" >&2; exit 2 ;;
  esac
  if ! guide_on; then echo "Off: agents don't get the guide ($guide)."
  elif [ ! -s "$guide" ]; then echo "On, but there's no guide yet: write one in $guide."
  else echo "On: Claude, Codex, Antigravity and Pi get $guide ($(wc -c < "$guide" | tr -d ' ') bytes), except presets with guide: off."; fi
  exit 0
fi
case "${1:-}" in
  -h | --help)
    # This file's opening comment, without its "# ".
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
    exit 0 ;;
  --presets) mode=list; shift ;;
  --preset) [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; mode=preset; pname=$2; shift 2 ;;
esac
if [ -z "$mode" ]; then
  while [ "${1:-}" = --instructions ] || [ "${1:-}" = --task ]; do
    [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }
    if [ "$1" = --task ]; then task=$2; else presets="$presets$2
"; fi
    shift 2
  done
  [ $# -ge 1 ] || { echo "$usage" >&2; exit 2; }
  # An option where the agent goes is a typo, not a program to start.
  case $1 in -*) echo "herdr-ws-agent: unknown option $1" >&2; echo "$usage" >&2; exit 2 ;; esac
  agent=$1
  shift
fi
# Continuing a conversation (a restart's resume, History's Resume) isn't a new start:
# History's family tree (noteparent below) leaves it out.
resumed=
case "${agent##*/}:${1:-}" in codex:resume | codex:fork) resumed=1 ;; esac
for w in "$@"; do
  case "${agent##*/}:$w" in
    claude:--resume | claude:--resume=* | claude:-r | claude:--continue | claude:-c | agy:--conversation | agy:--conversation=* | \
    pi:--session | pi:--session=* | pi:--continue | pi:-c | pi:--resume | pi:-r | pi:--fork | pi:--fork=* | grok:--resume | grok:--resume=* | \
    opencode:--session | opencode:--session=* | opencode:--continue | opencode:-c) resumed=1 ;;
  esac
done
# The words that start this again after a restart (herdr-ws-resume): Claude's
# command without its prompt (the first message, sent once) and without a session
# to resume, which herdr-ws-resume adds. As Claude reads its words: the flags in
# $bare take no value, those in $many every word up to the next flag, any other
# flag the next word; a word no flag takes is the prompt.
bare=" --allow-dangerously-skip-permissions --ax-screen-reader --bg --background --bare --brief --chrome --no-chrome --dangerously-skip-permissions --desktop --disable-slash-commands --exclude-dynamic-system-prompt-sections --forward-subagent-text --ide --include-hook-events --include-partial-messages --no-session-persistence -p --print --replay-user-messages --restricted --safe-mode --strict-mcp-config --verbose "
many=" --add-dir --allowedTools --allowed-tools --betas --disallowedTools --disallowed-tools --file --mcp-config --tools "
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
note=herdr-ws-agent skip= take=
while IFS= read -r f; do
  [ -n "$f" ] && note="$note --instructions $(q "$f")"
done <<EOF
$presets
EOF
note="$note $(q "$agent")"
# Antigravity's flags (Go's flag package): those in $bare take no value, any other
# the next word. Its first message (-i) and the conversation it continues
# (--conversation) stay out, and a print run (-p, --print, --prompt) isn't noted.
oneshot=
if [ "${agent##*/}" = agy ]; then
  bare=" --dangerously-skip-permissions --disable-slash-commands --new-project --remote-agent --remote-control --sandbox -h --help "
  many=" "
fi
for w in "$@"; do
  if [ -n "$skip" ]; then skip=; case "$w" in -*) ;; *) continue ;; esac; fi
  if [ "${agent##*/}" = agy ] && [ -z "$take" ]; then
    case "$w" in
      -i | --prompt-interactive | --conversation) skip=1; continue ;;
      -i=* | --prompt-interactive=* | --conversation=*) continue ;;
      -p | --print | --prompt | -p=* | --print=* | --prompt=*) oneshot=1 ;;
    esac
  fi
  # Claude's print run gets no status line.
  if [ "${agent##*/}" = claude ] && [ -z "$take" ]; then
    case "$w" in -p | --print) oneshot=1 ;; esac
  fi
  if [ "$take" = one ]; then take=; case "$w" in -*) ;; *) note="$note $(q "$w")"; continue ;; esac; fi
  if [ "$take" = all ]; then case "$w" in -*) take= ;; *) note="$note $(q "$w")"; continue ;; esac; fi
  [ "$take" = rest ] && continue
  case "$w" in
    --) take=rest; continue ;;
    --resume | -r | --session-id) skip=1; continue ;;
    --resume=* | --session-id=* | --continue | -c | --fork-session) continue ;;
    --*=*) ;;
    -*) case "$bare" in *" $w "*) ;; *) case "$many" in *" $w "*) take=all ;; *) take=one ;; esac ;; esac ;;
    *) continue ;;
  esac
  note="$note $(q "$w")"
done

index=$HOME/.herdr/workspaces/.index
trees=$HOME/.herdr/worktrees
tab=$(printf '\t')
cwd=$(pwd -P)

# herdr-ws-resume, which brings agents back after a restart: beside this script
# (following its symlink), else on PATH.
self=$0
[ -L "$self" ] && link=$(readlink "$self") && case "$link" in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
resume=$(dirname "$self")/herdr-ws-resume
[ -x "$resume" ] || resume=$(command -v herdr-ws-resume 2>/dev/null) || resume=
# Started under another agent (hc run from its terminal): herdr-ws-resume --parent notes
# who started it, for the History screen, in the background so the agent never waits
# for it. $1: the agent's program, $2: its preset, $3: "hooked" when it got the hook that
# notes its session (Claude, Antigravity), which then says exactly which conversation it
# is. Not for a conversation it continues.
noteparent() {
  [ -z "${HERDR_WS_AGENT_DRY:-}" ] && [ -z "$resumed" ] && [ -n "${HC_TERMINAL_ID:-}" ] && [ -n "${HC_TERMINAL_SOCKET:-}" ] && [ -n "$resume" ] || return 0
  "$resume" --parent "${1##*/}" "$cwd" "$2" "${3:-}" </dev/null >/dev/null 2>&1 &
}

# The folder as the file system sees it (a root may be a symlink).
real() { (cd "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"; }
# $1 is $2 or inside it.
holds() { case "$1/" in "$2"/*) return 0 ;; esac; return 1; }

ws= root= instructions=
if [ -r "$index" ]; then
  # The most specific root or folder holding this folder.
  best=-1
  while IFS=$tab read -r kind id path _; do
    [ "$kind" = dir ] || continue
    path=$(real "$path")
    if holds "$cwd" "$path" && [ ${#path} -gt $best ]; then ws=$id; best=${#path}; fi
  done < "$index"
  # A herdr worktree (~/.herdr/worktrees/<repo>/<branch>) goes by its repo.
  if [ -z "$ws" ] && holds "$cwd" "$(real "$trees")"; then
    repo=${cwd#"$(real "$trees")"/}
    repo=${repo%%/*}
    while IFS=$tab read -r kind id name _; do
      if [ "$kind" = repo ] && [ "$name" = "$repo" ]; then ws=$id; break; fi
    done < "$index"
  fi
  if [ -n "$ws" ]; then
    while IFS=$tab read -r kind id path file; do
      if [ "$kind" = ws ] && [ "$id" = "$ws" ]; then root=$path; instructions=$file; break; fi
    done < "$index"
  fi
fi

# A file's instructions: without front matter (--- lines at the top), without
# <!-- comments -->, and without blank lines at either end.
told() {
  awk 'NR == 1 && /^---[ \t\r]*$/ { head = 1; next }
       head && /^---[ \t\r]*$/ { head = 0; next }
       !head { s = s $0 "\n" }
       END {
         while ((i = index(s, "<!--")) > 0) {
           rest = substr(s, i + 4); j = index(rest, "-->")
           s = substr(s, 1, i - 1) (j ? substr(rest, j + 3) : "")
         }
         sub(/^[ \t\r\n]+/, "", s); sub(/[ \t\r\n]+$/, "", s); printf "%s", s }' "$1"
}

templates=${XDG_CONFIG_HOME:-$HOME/.config}/herdr-core/templates
wsdir=$HOME/.herdr/workspaces/$ws
# A front matter field of a preset file.
front() { awk -v k="$2" 'NR == 1 && /^---[ \t\r]*$/ { h = 1; next } h && /^---[ \t\r]*$/ { exit }
  h && index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^[ \t]+/, "", v); sub(/[ \t\r]+$/, "", v); print v; exit }' "$1"; }

if [ "$mode" = list ]; then
  own=" "
  if [ -n "$ws" ] && [ -d "$wsdir/agents" ]; then
    echo "Only in this workspace ($ws):"
    for f in "$wsdir"/agents/*.md; do
      [ -f "$f" ] || continue
      n=${f##*/}; n=${n%.md}
      printf '  %-16s %s\n' "$n" "$(front "$f" description)"
      own="$own$n "
    done
  fi
  echo "Every workspace:"
  for f in "$templates"/*.md; do
    [ -f "$f" ] || continue
    n=${f##*/}; n=${n%.md}
    case "$own" in
      *" $n "*) printf '  %-16s %s\n' "$n" "(this workspace's own $n is the one that runs)" ;;
      *) printf '  %-16s %s\n' "$n" "$(front "$f" description)" ;;
    esac
  done
  echo
  echo "Start one: hc run --bg --keep --name <name> herdr-ws-agent --preset <preset> \"<task>\""
  echo "It starts in your folder. Add --cwd <folder> for one that changes files somewhere else."
  exit 0
fi

if [ "$mode" = preset ]; then
  case "$pname" in */*|.*|'') echo "herdr-ws-agent: \"$pname\" is a preset's name, not a path" >&2; exit 2 ;; esac
  file=
  if [ -n "$ws" ] && [ -f "$wsdir/agents/$pname.md" ]; then file=$wsdir/agents/$pname.md
  elif [ -f "$templates/$pname.md" ]; then file=$templates/$pname.md
  else echo "herdr-ws-agent: there's no preset \"$pname\" here (herdr-ws-agent --presets lists them)" >&2; exit 1
  fi
  task=$*
  line=$(front "$file" command)
  [ -n "$line" ] || { echo "herdr-ws-agent: $file has no command" >&2; exit 1; }
  eval "set -- $line"
  [ "${1:-}" = env ] && shift
  while [ $# -gt 0 ]; do
    case "$1" in [A-Za-z_]*=*) export "${1%%=*}=${1#*=}"; shift ;; *) break ;; esac
  done
  [ "${1##*/}" = herdr-ws-agent ] && shift
  [ $# -ge 1 ] || { echo "herdr-ws-agent: $file's command names no program" >&2; exit 1; }
  case "${1##*/}" in
    claude|codex|agy|pi)
      [ -n "$task" ] && exec "$0" --task "$task" --instructions "$file" "$@"
      exec "$0" --instructions "$file" "$@"
      ;;
  esac
  # Any other agent: its instructions, then the task, as its first message (as hc does).
  body=$(told "$file")
  first=
  [ -n "$body" ] && first="You are the \"$pname\" agent, started from the Herdr agent preset of that name ($file). Its instructions:

$body"
  [ -n "$task" ] && first=${first:+$first

}$task
  [ -n "$first" ] && set -- "$@" "$first"
  if [ -n "${HERDR_WS_AGENT_DRY:-}" ]; then
    printf 'workspace: %s\n' "${ws:-none}"
    printf '%s\n' "$@"
    exit 0
  fi
  noteparent "$1" "$pname"
  exec "$@"
fi

# The command's own --settings (the first one). What the launcher adds to Claude's
# settings (the folders below, the restart hooks) goes into it, since a second
# --settings would replace it; only inline JSON can take them.
own= ownset= inline= prev=
for w in "$@"; do
  if [ "$prev" = --settings ]; then own=$w ownset=1; break; fi
  case "$w" in --settings=*) own=${w#--settings=} ownset=1; break ;; esac
  prev=$w
done
case "$(printf '%s' "$own" | sed '1s/^[[:space:]]*//')" in '{'*) inline=1 ;; esac
# A JSON string's inside.
json() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# Extra words go before the caller's: append them, then rotate the caller's to the end.
given=$#
name=${agent##*/}
# Give the agent a folder: Claude gets one of Herdr's own through its settings
# ($dirs, the quoted paths), anything else is --add-dir.
dirs=
give() {
  if [ "$name" = claude ] && holds "$1" "$HOME/.herdr" && { [ -z "$ownset" ] || [ -n "$inline" ]; }; then
    case "$own" in *'"additionalDirectories"'*) ;; *) dirs=${dirs:+$dirs,}\"$(json "$1")\"; return ;; esac
  fi
  added="$added$1
"
}
added=
# Antigravity's rules folder: the text $2 as $1/AGENTS.md, and what doesn't fit in
# 22,000 bytes, a paragraph at a time, as always-on rules in $1/.agents/rules/herdr-N.md.
# Built beside the folder and swapped in only when something changed, because a running
# agy reads these files at every turn.
agyrules() {
  case "$1" in "$HOME/.herdr/agy/"?*) ;; *) return 1 ;; esac
  new=$1.new.$$
  rm -rf "$new"
  mkdir -p "$new/.agents/rules" 2>/dev/null || return 1
  printf '%s\n' "$2" | LC_ALL=C awk -v dir="$new" -v max=22000 '
    function flush(   f) {
      if (out == "") return
      f = n ? dir "/.agents/rules/herdr-" n ".md" : dir "/AGENTS.md"
      if (n) printf "---\ntrigger: always_on\n---\n\n" > f
      printf "%s\n", out > f
      close(f); n++; out = ""
    }
    BEGIN { RS = ""; n = 0; out = "" }
    {
      if (out != "" && length(out) + length($0) + 2 > max) flush()
      out = (out == "" ? $0 : out "\n\n" $0)
    }
    END { flush() }' || { rm -rf "$new"; return 1; }
  # $3: its .agents/hooks.json (the hook that notes the conversation for a restart).
  [ -n "${3:-}" ] && printf '%s\n' "$3" > "$new/.agents/hooks.json"
  rmdir "$new/.agents/rules" "$new/.agents" 2>/dev/null
  if [ -d "$1" ] && diff -r "$new" "$1" >/dev/null 2>&1; then rm -rf "$new"; touch "$1"
  else rm -rf "$1" && mv "$new" "$1" || return 1
  fi
  # Each launch touches its own folder; one no launch has used for 90 days goes.
  find "$HOME/.herdr/agy" -mindepth 2 -maxdepth 2 -type d -mtime +90 -exec rm -rf {} + 2>/dev/null
  return 0
}
# Pi reads one context file in its working folder and in each folder above it: the
# first of AGENTS.override.md, AGENTS.md, AGENTS.MD, CLAUDE.md, CLAUDE.MD there. True
# when that's the file $1, so Pi gets it already (not with --no-context-files, -nc).
pireads() {
  [ "$name" = pi ] && [ -z "$pinc" ] || return 1
  at=$(real "${1%/*}")
  holds "$cwd" "$at" || return 1
  for c in AGENTS.override.md AGENTS.md AGENTS.MD CLAUDE.md CLAUDE.MD; do
    [ -e "$at/$c" ] || continue
    [ "$(printf '%s' "$c" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "${1##*/}" | tr '[:upper:]' '[:lower:]')" ]
    return
  done
  return 1
}
pinc= piappend=
if [ "$name" = pi ]; then
  for w in "$@"; do
    case "$w" in
      --) break ;;
      --no-context-files | -nc) pinc=1 ;;
      --append-system-prompt) piappend=1 ;;
    esac
  done
fi
if [ "$name" = claude ] || [ "$name" = codex ] || [ "$name" = agy ] || [ "$name" = pi ]; then
  # The global guide (what every agent here should know about Herdr: automations,
  # hc helpers, the board), then the workspace's instructions, then each preset's,
  # a blank line apart. A guide over 16 KB is only pointed at.
  # Left out while the switch is off, and for a preset with guide: off in its front
  # matter (a small job that doesn't need it).
  text= guided= noguide=
  guide_on || noguide=1
  while IFS= read -r file; do
    [ -n "$file" ] && [ -r "$file" ] && [ "$(front "$file" guide)" = off ] && noguide=1
  done <<EOF
$presets
EOF
  if [ -z "$noguide" ] && [ -s "$guide" ] && [ -r "$guide" ] && [ -n "$(told "$guide")" ]; then
    guided=1
    # Pi started under ~/.herdr (a worktree, the Scratch root) reads the guide itself.
    if pireads "$guide"; then :
    elif [ "$(wc -c < "$guide")" -le 16384 ]; then text=$(told "$guide")
    else text="How to work in Herdr (automations, hc helpers, the board) is in $guide. Read it before using any of them."; fi
  fi
  [ -n "$ws" ] && [ -r "$instructions" ] && ! pireads "$instructions" && more=$(told "$instructions") && [ -n "$more" ] && text=${text:+$text

}$more
  while IFS= read -r file; do
    [ -n "$file" ] && [ -r "$file" ] || continue
    more=$(told "$file")
    [ -n "$more" ] || continue
    # Named, so the agent can say which preset it is.
    preset=${file##*/}
    more="You are the \"${preset%.md}\" agent, started from the Herdr agent preset of that name ($file). Its instructions:

$more"
    text=${text:+$text

}$more
  done <<EOF
$presets
EOF
  # Where the workspace's work stands: its BRIEF.md, whole for an agent with no
  # preset, a pointer for a preset's agent (and for a brief too long to hand over).
  brief=$wsdir/BRIEF.md
  if [ -n "$ws" ] && [ -s "$brief" ] && [ -r "$brief" ]; then
    stands=
    if [ -z "$(printf '%s' "$presets" | tr -d ' \t\n')" ] && [ "$(wc -c < "$brief")" -le 16384 ]; then
      stands=$(told "$brief")
    elif [ -n "$(told "$brief")" ]; then
      stands="Where the work in this workspace stands (what happened lately, what's open or waiting on someone) is kept in $brief. Read it when that would help with what you're asked."
    fi
    [ -n "$stands" ] && text=${text:+$text

}$stands
  fi
  # In a workspace, the agent can leave work for later: a Herdr automation. With a
  # guide, the guide says how; the agent is only told which workspace it's in.
  if [ -n "$ws" ] && [ -n "$guided" ]; then
    later="You're working in the Herdr workspace \"$ws\" (its config, board cards and automations: $wsdir)."
    text=${text:+$text

}$later
  elif [ -n "$ws" ] && command -v herdr-ws-run >/dev/null 2>&1; then
    later="You're working in the Herdr workspace \"$ws\". When you're asked to do something later or on a schedule (\"tomorrow at 6, check X and if so do Y\"), set it up as a Herdr automation with herdr-ws-run --add; run herdr-ws-run --help first. It starts a new agent at that time, so its prompt must say everything that agent needs."
    text=${text:+$text

}$later
  fi
  # The whole workspace is the agent's to read and edit, and its folders that live elsewhere.
  if [ -n "$ws" ]; then
    realroot=$(real "$root")
    [ -d "$root" ] && [ "$realroot" != "$cwd" ] && give "$root"
    while IFS=$tab read -r kind id path _; do
      [ "$kind" = dir ] && [ "$id" = "$ws" ] && [ -d "$path" ] || continue
      p=$(real "$path")
      holds "$p" "$realroot" || [ "$p" = "$cwd" ] || give "$path"
    done < "$index"
    # Its board cards too: a card's agent notes its status and pull request there.
    [ -d "$wsdir/tasks" ] && give "$wsdir/tasks"
    # And its notes: an agent asked to note something for later writes it there.
    [ -d "$wsdir/notes" ] && give "$wsdir/notes"
  fi
  if [ "$name" = pi ]; then
    # Pi takes no folders, so it's told them. And a folder's own .pi/APPEND_SYSTEM.md,
    # which Pi drops for a --append-system-prompt, is pointed at.
    if [ -n "$(printf '%s' "$added" | tr -d '\n')" ]; then
      more="Besides your working folder ($cwd), these are yours to read and edit too:
$(printf '%s' "$added" | sed '/^$/d; s/^/- /')"
      text=${text:+$text

}$more
    fi
    if [ -z "$piappend" ] && [ -f "$cwd/.pi/APPEND_SYSTEM.md" ]; then
      text=${text:+$text

}"This folder's .pi/APPEND_SYSTEM.md isn't in your system prompt (Herdr adds its own instructions in its place). Read $cwd/.pi/APPEND_SYSTEM.md and follow it as if it were."
    fi
  fi
  if [ -n "$text" ]; then
    if [ "$name" = claude ]; then
      set -- "$@" --append-system-prompt "$text"
    elif [ "$name" = agy ]; then
      # agy runs a command in the first of its folders by path, not in the one it was
      # started in, so the text names that folder. Its rules folder is named after the
      # text's checksum: launches with the same text share one, and no launch changes
      # the text a running agy reads.
      text="$text

Your working folder is $cwd. Run every command there: give it as the working directory of each command you run, because the default is whichever of your folders comes first by name. Herdr's own commands (hc, herdr-ws-agent, herdr-ws-run, herdr-app) can't run inside your terminal sandbox (\"operation not permitted\"): run them outside it."
      case "$ws" in ''|.*|*/*) wskey=_ ;; *) wskey=$ws ;; esac
      rules=$HOME/.herdr/agy/$wskey/$(printf '%s' "$text" | cksum | tr -s ' \t' '-' | sed 's/-*$//')
      text="$text

The folder $rules only holds these instructions: never run a command in it or keep files there."
      # Its hook for a restart: Antigravity runs the hooks in .agents/hooks.json of its
      # folders, and herdr-ws-resume notes the conversation for this terminal (where the
      # launcher noted no command, it does nothing). PreInvocation, before each model
      # call: a conversation it continues (--conversation) never has a SessionStart.
      # Antigravity wants JSON back.
      agyhooks=
      if [ -n "$resume" ]; then
        hook=$(json "'$resume' --hook >/dev/null 2>&1; printf '{}\\n'")
        agyhooks="{\"herdr-resume\":{\"PreInvocation\":[{\"type\":\"command\",\"command\":\"$hook\",\"timeout\":10}]}}"
      fi
      if [ -n "${HERDR_WS_AGENT_DRY:-}" ] || agyrules "$rules" "$text" "$agyhooks"; then set -- "$@" --add-dir "$rules"; fi
    elif [ "$name" = pi ]; then
      # Pi reads a file named there, and takes anything else as the text itself. Its
      # own APPEND_SYSTEM.md, which a --append-system-prompt replaces, goes first.
      piown=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/APPEND_SYSTEM.md
      [ -z "$piappend" ] && [ ! -f "$cwd/.pi/APPEND_SYSTEM.md" ] && [ -f "$piown" ] && set -- "$@" --append-system-prompt "$piown"
      set -- "$@" --append-system-prompt "$text"
    else
      # A TOML string: backslashes and quotes escaped, lines joined with \n.
      toml=$(printf '%s\n' "$text" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r$//' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }')
      set -- "$@" -c "developer_instructions=\"$toml\""
    fi
  fi
  # The folders found above, as --add-dir (Pi has none: its text names them).
  if [ -n "$ws" ] && [ "$name" != pi ]; then
    while IFS= read -r path; do
      [ -n "$path" ] && set -- "$@" --add-dir "$path"
    done <<EOF
$added
EOF
  fi
fi

# Brought back after a restart (herdr-ws-resume): in a herdr-core terminal, Claude
# gets hooks that note its session, and its command is noted. The hooks go into the
# command's own inline --settings too; a --settings file, or settings with hooks of
# their own, leave it out of restarts. Antigravity's hook is in its rules folder,
# so it only gets the note (not a print run, -p).
# Off (herdr-ws-resume --off, or the Agent presets screen): no hooks, no note.
switch=${HERDR_WS_RESUME_DIR:-$HOME/.herdr/resume}/switch
hooks= agynote=
if [ "$name" = agy ] && [ -z "$oneshot" ] && [ -n "$resume" ] && [ "$(sed -n 1p "$switch" 2>/dev/null)" != off ] && [ -n "${HC_TERMINAL_ID:-}" ] && [ -n "${HC_TERMINAL_SOCKET:-}" ]; then
  agynote=1
fi
if [ "$name" = claude ] && [ -n "$resume" ] && [ "$(sed -n 1p "$switch" 2>/dev/null)" != off ] && [ -n "${HC_TERMINAL_ID:-}" ] && [ -n "${HC_TERMINAL_SOCKET:-}" ]; then
  hook=$(printf '%s' "'$resume' --hook" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
  hooks="{\"SessionStart\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"$hook\",\"timeout\":10}]}],\"SessionEnd\":[{\"matcher\":\"prompt_input_exit|logout\",\"hooks\":[{\"type\":\"command\",\"command\":\"$hook\",\"timeout\":10}]}]}"
fi
if [ -n "$hooks" ] && [ -n "$ownset" ]; then
  [ -n "$inline" ] || hooks=
  case "$own" in *'"hooks"'*) hooks= ;; esac
fi
# The Agents list's numbers (model, context, the account's limits): in a herdr-core
# terminal, Claude's status line is herdr-ws-statusline, which keeps what Claude hands
# it. Not where a status line is set already (your settings, the folder's, the
# command's own), nor in a print run (-p), which has none.
sline=
if [ "$name" = claude ] && [ -z "$oneshot" ] && [ -n "${HC_TERMINAL_ID:-}" ] && [ -n "${HC_TERMINAL_SOCKET:-}" ] && { [ -z "$ownset" ] || [ -n "$inline" ]; }; then
  statusline=$(dirname "$self")/herdr-ws-statusline
  [ -x "$statusline" ] || statusline=$(command -v herdr-ws-statusline 2>/dev/null) || statusline=
  case "$own" in *'"statusLine"'*) statusline= ;; esac
  for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" .claude/settings.json .claude/settings.local.json; do
    grep -q '"statusLine"' "$f" 2>/dev/null && statusline=
  done
  [ -n "$statusline" ] && sline="{\"type\":\"command\",\"command\":\"$(json "'$statusline'")\"}"
fi
# Pi's numbers, the same way: in a herdr-core terminal it loads the extension
# herdr-stats.ts (in ../pi beside this script), which keeps them. Not in a print run.
if [ "$name" = pi ] && [ -n "${HC_TERMINAL_ID:-}" ] && [ -n "${HC_TERMINAL_SOCKET:-}" ]; then
  piext=$(cd "$(dirname "$self")/.." 2>/dev/null && pwd -P)/pi/herdr-stats.ts
  for w in "$@"; do
    case "$w" in --) break ;; -p | --print) piext= ;; esac
  done
  [ -n "$piext" ] && [ -f "$piext" ] && set -- "$@" -e "$piext"
fi
# Inline settings JSON with the hooks and the folders added. The folders go first
# in its own top-level "permissions", or in a new one.
withextras() {
  s=$1 add=
  [ -n "$hooks" ] && add="\"hooks\":$hooks"
  [ -n "$sline" ] && add=${add:+$add,}"\"statusLine\":$sline"
  if [ -n "$dirs" ]; then
    list="\"additionalDirectories\":[$dirs]"
    if p=$(printf '%s' "$s" | HERDR_WS_ADD=$list awk '
      { s = s (NR > 1 ? "\n" : "") $0 }
      END {
        n = length(s); depth = 0; instr = 0; want = 0; at = 0; last = ""
        for (i = 1; i <= n; i++) {
          c = substr(s, i, 1)
          if (instr) {
            if (c == "\\") i++
            else if (c == "\"") { instr = 0; last = substr(s, from + 1, i - from - 1) }
            continue
          }
          if (c == "\"") { instr = 1; from = i; want = 0; continue }
          if (c == "{" && depth == 1 && want) { at = i; break }
          if (c == "{" || c == "[") { depth++; want = 0; continue }
          if (c == "}" || c == "]") { depth--; want = 0; continue }
          if (c == ":" && depth == 1) { want = (last == "permissions"); continue }
          if (c !~ /[ \t\r\n]/) want = 0
        }
        if (!at) exit 1
        rest = substr(s, at + 1); t = rest; sub(/^[ \t\r\n]+/, "", t)
        printf "%s%s%s%s", substr(s, 1, at), ENVIRON["HERDR_WS_ADD"], (substr(t, 1, 1) == "}" ? "" : ","), rest
      }'); then s=$p
    else add=${add:+$add,}"\"permissions\":{$list}"
    fi
  fi
  [ -n "$add" ] || { printf '%s' "$s"; return; }
  rest=$(printf '%s' "$s" | sed '1s/^[[:space:]]*{//')
  case "$(printf '%s' "$rest" | sed '1s/^[[:space:]]*//')" in
    '}'*) printf '{%s%s' "$add" "$rest" ;;
    *) printf '{%s,%s' "$add" "$rest" ;;
  esac
}
new=
if [ -n "$hooks$dirs$sline" ]; then
  base=$own
  [ -n "$ownset" ] || base='{}'
  new=$(withextras "$base")
fi

# Rotate: the caller's words (the first $given) move after the extras.
i=0 prev= merged=
while [ $i -lt "$given" ]; do
  w=$1
  if [ -n "$new" ] && [ -z "$merged" ]; then
    if [ "$prev" = --settings ]; then w=$new merged=1
    else case "$w" in --settings=*) w=--settings=$new merged=1 ;; esac
    fi
  fi
  set -- "$@" "$w"
  shift
  prev=$w
  i=$((i + 1))
done

[ -n "$new" ] && [ -z "$merged" ] && set -- "$@" --settings "$new"
if [ -n "$hooks$agynote" ]; then
  if [ -z "${HERDR_WS_AGENT_DRY:-}" ]; then
    core=${HC_TERMINAL_SOCKET##*/}
    notes=${HERDR_WS_RESUME_DIR:-$HOME/.herdr/resume}/${core%.sock}
    if mkdir -p "$notes" 2>/dev/null; then
      rm -f "$notes/$HC_TERMINAL_ID.session"
      printf '%s\n' "$note" > "$notes/$HC_TERMINAL_ID.cmd"
      # Drop the notes of terminals that are gone (their tab was closed).
      if command -v hc >/dev/null 2>&1; then
        (live=$(hc ls --json 2>/dev/null) || exit 0
          case "$live" in *'"address"'*) ;; *) exit 0 ;; esac
          for f in "$notes"/*.cmd; do
            [ -f "$f" ] || continue
            t=${f##*/}; t=${t%.cmd}
            [ "$t" = "$HC_TERMINAL_ID" ] && continue
            case "$live" in *"\"address\":\"$t\""*) ;; *) rm -f "$f" "${f%.cmd}.session" "${f%.cmd}.parent" ;; esac
          done) >/dev/null 2>&1 &
      fi
    fi
  fi
fi
# The first message: last on the command line, and for agy with -i (a bare word isn't one there).
if [ -n "$task" ]; then
  if [ "$name" = agy ]; then set -- "$@" -i "$task"
  elif [ "$name" = pi ]; then
    # After -- (unless the command has one): else Pi reads a task starting with - as
    # a flag, and a flag of an extension it doesn't know takes the task as its value.
    # Even after --, a word starting with @ is a file to attach, so a space goes first.
    dd=
    for w in "$@"; do [ "$w" = -- ] && dd=1 && break; done
    case "$task" in @*) task=" $task" ;; esac
    if [ -n "$dd" ]; then set -- "$@" "$task"; else set -- "$@" -- "$task"; fi
  else set -- "$@" "$task"; fi
fi

if [ -n "${HERDR_WS_AGENT_DRY:-}" ]; then
  printf 'workspace: %s\n' "${ws:-none}"
  printf '%s\n' "$agent" "$@"
  exit 0
fi
# Its preset: the last --instructions file's name.
last=$(printf '%s' "$presets" | sed '/^$/d' | tail -n 1)
last=${last##*/}
hooked=
[ -n "$hooks$agynote" ] && hooked=hooked
noteparent "$agent" "${last%.md}" "$hooked"
exec "$agent" "$@"
