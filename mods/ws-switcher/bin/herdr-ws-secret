#!/bin/sh
# Use secrets from Herdr's Vault without seeing them: herdr-ws-secret list, http, run.
# No command prints a value. herdr-ws-secret --help says the rest.
#
# The code is the ws-switcher mod's vault/cli.js; this finds it through its own link (in
# ~/.local/bin) and runs it with Node 20 or newer.
set -eu

self=$0
while [ -L "$self" ]; do
  t=$(readlink "$self")
  case $t in /*) self=$t ;; *) self=$(dirname "$self")/$t ;; esac
done
mod=$(cd "$(dirname "$self")/.." && pwd)

command -v node >/dev/null 2>&1 || { echo "herdr-ws-secret: Node isn't on your PATH. It needs Node 20 or newer." >&2; exit 127; }
node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 20 ? 0 : 1)' ||
  { echo "herdr-ws-secret: Node $(node -v) is too old. It needs 20 or newer." >&2; exit 1; }
exec node "$mod/vault/cli.js" "$@"
