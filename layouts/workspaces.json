{
  "id": "root",
  "toast": "ws-toast",
  "cloned_from": {
    "name": "main",
    "version": "0.1.14"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "workspace-switcher",
          "type": "block",
          "size": {
            "px": 44
          },
          "content": {
            "mod": "ws-switcher"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "ws-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "ws-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "ws-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 153
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "center",
      "type": "stack",
      "active": "work",
      "children": [
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "ws-tabs"
              },
              "size": {
                "px": 42
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  },
                  "min": 400
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true
                }
              ],
              "padding": 8,
              "gap": 8
            },
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "ws-status"
              },
              "size": {
                "px": 28
              }
            }
          ],
          "resizable": false
        },
        {
          "id": "empty",
          "type": "block",
          "content": {
            "mod": "ws-switcher",
            "props": {
              "empty": true
            }
          },
          "window_drag": true
        },
        {
          "id": "screens",
          "type": "column",
          "resizable": false,
          "children": [
            {
              "id": "screens-tabs",
              "type": "block",
              "content": {
                "mod": "ws-tabs",
                "props": {
                  "screens": true
                }
              },
              "size": {
                "px": 42
              },
              "window_drag": true
            },
            {
              "id": "screens-body",
              "type": "stack",
              "active": "screen-board",
              "children": [
                {
                  "id": "screen-board",
                  "type": "block",
                  "content": {
                    "mod": "ws-board",
                    "props": {
                      "screen": true
                    }
                  }
                },
                {
                  "id": "screen-worktrees",
                  "type": "block",
                  "content": {
                    "mod": "ws-worktrees",
                    "props": {
                      "screen": true
                    }
                  }
                },
                {
                  "id": "screen-history",
                  "type": "block",
                  "content": {
                    "mod": "ws-history",
                    "props": {
                      "screen": true
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "mods/ws-switcher/preview.svg"
}
